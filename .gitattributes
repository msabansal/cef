# Generated byte-exact goldens may intentionally include blank lines at EOF.
tools/testdata/make_generators/golden/** whitespace=blank-at-eol,-blank-at-eof,space-before-tab

# Frozen Reach overlays/provenance retain their independently pinned bytes.
patch/overlays/reach_*.patch -text whitespace=-blank-at-eol,-blank-at-eof
patch/provenance/reach_*.patch -text whitespace=-blank-at-eol,-blank-at-eof
