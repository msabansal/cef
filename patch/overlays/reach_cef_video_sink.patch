+  void Disconnected() { Error("Reach compositor video sink disconnected"); }
+
+  const raw_ptr<CefRenderWidgetHostViewOSR> view_;
+  mojo::Receiver<viz::mojom::ReachVideoSink> receiver_;
+  std::string stream_;
