+      auto arguments = message->GetArgumentList();
+      auto input = arguments ? arguments->GetList(2) : nullptr;
+      if (input && input->GetSize() == 7 && input->GetInt(0) == 0) {
+        // Drawing dispatch already resolved the exact live frame. It bypasses
