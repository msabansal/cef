+#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_HTML_MEDIA_REACH_MEDIA_JOURNAL_H_
+#define THIRD_PARTY_BLINK_RENDERER_CORE_HTML_MEDIA_REACH_MEDIA_JOURNAL_H_
+
+#include <cstdint>
+#include <deque>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/memory/ref_counted.h"
+#include "base/memory/scoped_refptr.h"
+#include "third_party/blink/renderer/core/core_export.h"
+#include "third_party/blink/renderer/platform/heap/persistent.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+
+namespace blink {
+
+class HTMLMediaElement;
+class LocalFrame;
+
+// Reach drawing mode: a bounded record of the MediaSource operations a page
+// performs for a same-thread media element, so a remote client can replay them
+// into its own MediaSource. Main thread only; inactive unless enabled.
+class CORE_EXPORT ReachMediaJournal final
+    : public base::RefCounted<ReachMediaJournal> {
+ public:
+  enum class Kind : uint8_t {
+    kAddBuffer = 1,
+    kRemoveBuffer = 2,
+    kAppend = 3,
+    kRemove = 4,
+    kAbort = 5,
+    kTimestampOffset = 6,
+    kAppendWindowStart = 7,
+    kAppendWindowEnd = 8,
+    kMode = 9,
+    kChangeType = 10,
+    kDuration = 11,
+    kEndOfStream = 12,
+  };
+
+  // Enables journaling in this renderer. |changed| learns of every recorded
+  // operation, with the journaled element's local frame root.
+  static void Enable(void (*changed)(LocalFrame&));
+  // Null unless enabled. Replaces any journal of |element|.
+  static scoped_refptr<ReachMediaJournal> Start(HTMLMediaElement& element);
+  static ReachMediaJournal* ForElement(const HTMLMediaElement& element);
+  static ReachMediaJournal* Find(uint64_t id);
+
+  ReachMediaJournal(const ReachMediaJournal&) = delete;
+  ReachMediaJournal& operator=(const ReachMediaJournal&) = delete;
+
+  uint64_t id() const { return id_; }
+  // Sequence number the next operation will receive.
+  uint64_t next() const { return next_; }
+  // False after unsupported operations (e.g. encoded chunks) or closing.
+  bool usable() const { return !unsupported_ && !closed_; }
+  HTMLMediaElement* element() const;
+
+  // Returns the buffer identity used by later operations.
+  int AddBuffer(const String& type);
+  void Record(Kind kind,
+              int buffer,
+              double a = 0,
+              double b = 0,
+              const String& text = String());
+  // As Record, with |text| already UTF-8 (e.g. a literal).
+  void RecordUtf8(Kind kind,
+                  int buffer,
+                  double a,
+                  double b,
+                  std::string_view text);
+  void Append(int buffer, base::span<const uint8_t> data);
+  void Unsupported();
+  void Close();
+
+  // Serialized operations from |cursor| (0 = from the start), at most
+  // |max_bytes| but always at least one when any remain. A cursor whose
+  // operations were compacted away is answered from the start, flagged reset.
+  std::vector<uint8_t> Read(uint64_t cursor, size_t max_bytes) const;
+
+ private:
+  friend class base::RefCounted<ReachMediaJournal>;
+
+  explicit ReachMediaJournal(HTMLMediaElement& element);
+  ~ReachMediaJournal();
+
+  struct Entry {
+    uint64_t seq;
+    Kind kind;
+    int buffer;
+    double a;
+    double b;
+    std::string text;
+    std::vector<uint8_t> data;
+    bool init;
+  };
+
+  void Push(Entry entry);
+  void Compact();
+  void Changed();
+
+  const uint64_t id_;
+  WeakPersistent<HTMLMediaElement> element_;
+  std::deque<Entry> entries_;
+  std::vector<int> expects_init_;
+  uint64_t next_ = 1;
+  // Highest sequence number removed by compaction.
+  uint64_t dropped_ = 0;
+  size_t bytes_ = 0;
+  int next_buffer_ = 1;
+  bool unsupported_ = false;
+  bool closed_ = false;
+};
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_HTML_MEDIA_REACH_MEDIA_JOURNAL_H_
