new file mode 100644
index 0000000..fb91a17
--- /dev/null
+++ third_party/blink/renderer/core/html/media/reach_media_journal.cc
@@ -0,0 +1,301 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "third_party/blink/renderer/core/html/media/reach_media_journal.h"
+
+#include <algorithm>
+#include <bit>
+#include <map>
+#include <string_view>
+#include <type_traits>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "third_party/blink/renderer/core/dom/document.h"
+#include "third_party/blink/renderer/core/frame/local_frame.h"
+#include "third_party/blink/renderer/core/html/media/html_media_element.h"
+
+namespace blink {
+
+namespace {
+
+// One append larger than this disables the journal (the page still plays).
+constexpr size_t kMaxOperationBytes = 16 * 1024 * 1024;
+// Older media appends are compacted away beyond these budgets; the latest
+// initialization segment of every buffer is always kept.
+constexpr size_t kMaxJournalBytes = 64 * 1024 * 1024;
+constexpr size_t kMaxTotalBytes = 192 * 1024 * 1024;
+constexpr size_t kMaxEntries = 65536;
+constexpr size_t kMaxTextBytes = 256;
+constexpr size_t kEntryOverhead = 64;
+
+void (*g_changed)(LocalFrame&) = nullptr;
+size_t g_total_bytes = 0;
+uint64_t g_next_id = 1;
+
+std::map<uint64_t, ReachMediaJournal*>& Journals() {
+  static base::NoDestructor<std::map<uint64_t, ReachMediaJournal*>> journals;
+  return *journals;
+}
+
+// WebM EBML header, or an ISO BMFF ftyp/moov box.
+bool IsInitializationSegment(base::span<const uint8_t> data) {
+  if (data.size() >= 4 && data[0] == 0x1A && data[1] == 0x45 &&
+      data[2] == 0xDF && data[3] == 0xA3) {
+    return true;
+  }
+  if (data.size() < 8) {
+    return false;
+  }
+  const auto box = data.subspan(4u, 4u);
+  const std::string_view type(reinterpret_cast<const char*>(box.data()),
+                              box.size());
+  return type == "ftyp" || type == "moov";
+}
+
+template <typename T>
+void Put(std::vector<uint8_t>& out, T value) {
+  if constexpr (std::is_floating_point_v<T>) {
+    static_assert(sizeof(T) == sizeof(uint64_t));
+    Put<uint64_t>(out, std::bit_cast<uint64_t>(value));
+  } else {
+    const auto bytes = base::byte_span_from_ref(value);
+    out.insert(out.end(), bytes.begin(), bytes.end());
+  }
+}
+
+template <typename T>
+void PutAt(std::vector<uint8_t>& out, size_t offset, T value) {
+  base::span(out).subspan(offset, sizeof(T)).copy_from(
+      base::byte_span_from_ref(value));
+}
+
+}  // namespace
+
+void ReachMediaJournal::Enable(void (*changed)(LocalFrame&)) {
+  g_changed = changed;
+}
+
+scoped_refptr<ReachMediaJournal> ReachMediaJournal::Start(
+    HTMLMediaElement& element) {
+  if (!g_changed) {
+    return nullptr;
+  }
+  if (auto* previous = ForElement(element)) {
+    previous->Close();
+  }
+  return base::WrapRefCounted(new ReachMediaJournal(element));
+}
+
+ReachMediaJournal* ReachMediaJournal::ForElement(
+    const HTMLMediaElement& element) {
+  for (const auto& [id, journal] : Journals()) {
+    if (journal->element_.Get() == &element) {
+      return journal;
+    }
+  }
+  return nullptr;
+}
+
+ReachMediaJournal* ReachMediaJournal::Find(uint64_t id) {
+  const auto found = Journals().find(id);
+  return found == Journals().end() ? nullptr : found->second;
+}
+
+ReachMediaJournal::ReachMediaJournal(HTMLMediaElement& element)
+    : id_(g_next_id++), element_(&element) {
+  Journals()[id_] = this;
+}
+
+ReachMediaJournal::~ReachMediaJournal() {
+  Journals().erase(id_);
+  g_total_bytes -= bytes_;
+}
+
+HTMLMediaElement* ReachMediaJournal::element() const {
+  return element_.Get();
+}
+
+int ReachMediaJournal::AddBuffer(const String& type) {
+  if (!usable()) {
+    return 0;
+  }
+  const int buffer = next_buffer_++;
+  Record(Kind::kAddBuffer, buffer, 0, 0, type);
+  return usable() ? buffer : 0;
+}
+
+void ReachMediaJournal::Record(Kind kind,
+                               int buffer,
+                               double a,
+                               double b,
+                               const String& text) {
+  RecordUtf8(kind, buffer, a, b, text.IsNull() ? std::string() : text.Utf8());
+}
+
+void ReachMediaJournal::RecordUtf8(Kind kind,
+                                   int buffer,
+                                   double a,
+                                   double b,
+                                   std::string_view text) {
+  const bool buffered = kind != Kind::kDuration && kind != Kind::kEndOfStream;
+  if (!usable() || (buffered && buffer <= 0)) {
+    return;
+  }
+  if (text.size() > kMaxTextBytes) {
+    Unsupported();
+    return;
+  }
+  if (kind == Kind::kAddBuffer || kind == Kind::kChangeType) {
+    expects_init_.push_back(buffer);
+  }
+  Push({0, kind, buffer, a, b, std::string(text), {}, false});
+}
+
+void ReachMediaJournal::Append(int buffer, base::span<const uint8_t> data) {
+  if (!usable() || buffer <= 0) {
+    return;
+  }
+  if (data.size() > kMaxOperationBytes) {
+    Unsupported();
+    return;
+  }
+  bool init = IsInitializationSegment(data);
+  const auto expected =
+      std::find(expects_init_.begin(), expects_init_.end(), buffer);
+  if (expected != expects_init_.end()) {
+    init = true;
+    expects_init_.erase(expected);
+  }
+  Push({0, Kind::kAppend, buffer, 0, 0, std::string(),
+        std::vector<uint8_t>(data.begin(), data.end()), init});
+}
+
+void ReachMediaJournal::Unsupported() {
+  if (unsupported_) {
+    return;
+  }
+  unsupported_ = true;
+  g_total_bytes -= bytes_;
+  bytes_ = 0;
+  entries_.clear();
+  Changed();
+}
+
+void ReachMediaJournal::Close() {
+  if (closed_) {
+    return;
+  }
+  closed_ = true;
+  g_total_bytes -= bytes_;
+  bytes_ = 0;
+  entries_.clear();
+  Journals().erase(id_);
+}
+
+void ReachMediaJournal::Push(Entry entry) {
+  entry.seq = next_++;
+  const size_t size = entry.data.size() + entry.text.size() + kEntryOverhead;
+  bytes_ += size;
+  g_total_bytes += size;
+  entries_.push_back(std::move(entry));
+  Compact();
+  Changed();
+}
+
+void ReachMediaJournal::Compact() {
+  while (bytes_ > kMaxJournalBytes || entries_.size() > kMaxEntries ||
+         g_total_bytes > kMaxTotalBytes) {
+    std::map<int, uint64_t> latest_init;
+    for (const auto& entry : entries_) {
+      if (entry.kind == Kind::kAppend && entry.init) {
+        latest_init[entry.buffer] = entry.seq;
+      }
+    }
+    auto victim = std::find_if(
+        entries_.begin(), entries_.end(), [&](const Entry& entry) {
+          if (entry.kind != Kind::kAppend) {
+            return false;
+          }
+          const auto init = latest_init.find(entry.buffer);
+          return init == latest_init.end() || init->second != entry.seq;
+        });
+    if (victim == entries_.end()) {
+      if (bytes_ > kMaxJournalBytes || entries_.size() > kMaxEntries) {
+        Unsupported();
+      }
+      return;
+    }
+    const size_t size =
+        victim->data.size() + victim->text.size() + kEntryOverhead;
+    bytes_ -= size;
+    g_total_bytes -= size;
+    dropped_ = std::max(dropped_, victim->seq);
+    entries_.erase(victim);
+  }
+}
+
+void ReachMediaJournal::Changed() {
+  if (!g_changed) {
+    return;
+  }
+  HTMLMediaElement* element = element_.Get();
+  if (!element) {
+    return;
+  }
+  if (LocalFrame* frame = element->GetDocument().GetFrame()) {
+    g_changed(frame->LocalFrameRoot());
+  }
+}
+
+// Little endian:
+//   "RMJ1" | id u64 | next cursor u64 | flags u8 (1 reset, 2 closed,
+//   4 unsupported) | count u32 | operations
+// Operation:
+//   seq u64 | kind u8 | buffer i32 | a f64 | b f64 | text u16 + UTF-8 |
+//   data u32 + bytes
+std::vector<uint8_t> ReachMediaJournal::Read(uint64_t cursor,
+                                             size_t max_bytes) const {
+  const bool reset = cursor > 0 && cursor <= dropped_;
+  const uint64_t from = reset ? 0 : cursor;
+  std::vector<uint8_t> out = {'R', 'M', 'J', '1'};
+  Put<uint64_t>(out, id_);
+  const size_t next_offset = out.size();
+  Put<uint64_t>(out, from);
+  Put<uint8_t>(out, static_cast<uint8_t>((reset ? 1 : 0) | (closed_ ? 2 : 0) |
+                                         (unsupported_ ? 4 : 0)));
+  const size_t count_offset = out.size();
+  Put<uint32_t>(out, 0);
+  uint64_t next = from;
+  uint32_t count = 0;
+  for (const auto& entry : entries_) {
+    if (entry.seq < from) {
+      continue;
+    }
+    const size_t size =
+        41 + entry.text.size() + entry.data.size();
+    if (count && out.size() + size > max_bytes) {
+      break;
+    }
+    Put<uint64_t>(out, entry.seq);
+    Put<uint8_t>(out, static_cast<uint8_t>(entry.kind));
+    Put<int32_t>(out, entry.buffer);
+    Put<double>(out, entry.a);
+    Put<double>(out, entry.b);
+    Put<uint16_t>(out, static_cast<uint16_t>(entry.text.size()));
+    out.insert(out.end(), entry.text.begin(), entry.text.end());
+    Put<uint32_t>(out, static_cast<uint32_t>(entry.data.size()));
+    out.insert(out.end(), entry.data.begin(), entry.data.end());
+    next = entry.seq + 1;
+    ++count;
+  }
+  if (count == 0 && from == 0) {
+    next = next_;
+  }
+  PutAt<uint64_t>(out, next_offset, next);
+  PutAt<uint32_t>(out, count_offset, count);
+  return out;
+}
+
+}  // namespace blink
