+  Context2D()->FlushCanvas(FlushReason::kOther);
+  ASSERT_TRUE(Context2D()->GetLastRecording());
+  const size_t first_count = Context2D()->GetLastRecording()->total_op_count();
+  Context2D()->fillRect(4, 4, 2, 2);
+  Context2D()->FlushCanvas(FlushReason::kPrinting);
+  ASSERT_TRUE(Context2D()->GetLastRecording());
+  EXPECT_GT(Context2D()->GetLastRecording()->total_op_count(), first_count);
+  RunInTask(base::BindLambdaForTesting([this] { Context2D()->reset(); }));
+  EXPECT_FALSE(Context2D()->GetLastRecording());
+  Context2D()->fillRect(1, 1, 2, 2);
+  Context2D()->FlushCanvas(FlushReason::kPrinting);
+  ASSERT_TRUE(Context2D()->GetLastRecording());
+  EXPECT_LE(Context2D()->GetLastRecording()->total_op_count(), first_count);
+}
