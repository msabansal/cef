+PaintRecord PaintChunksToCcLayer::Convert(const PaintChunkSubset& chunks,
+                                          const PropertyTreeState& layer_state,
+                                          const gfx::Rect* cull_rect,
+                                          ChunkContentHook chunk_content) {
+  PaintOpBufferExt buffer;
+  {
+    // The context closes open states when destroyed.
+    ConversionContext context(layer_state, gfx::Vector2dF(), buffer);
+    context.SetChunkContentHook(&chunk_content);
+    context.Convert(chunks, cull_rect);
+  }
+  return buffer.ReleaseAsRecord();
