+  base::Value View(ReachWebGLCommand&, const DOMArrayBufferView&);
+  base::Value Reference(ReachWebGLCommand&, const ScriptWrappable*);
+  uint32_t CreateIdentity(ReachWebGLCommand&, const ScriptWrappable*);
+  void Fail(std::string_view);
+
+  template <typename T>
+  base::Value Encode(ReachWebGLCommand& command, const T& value) {
+    using V = std::remove_cvref_t<T>;
+    if (!command.error.empty())
+      return base::Value();
+    if constexpr (std::is_same_v<V, bool>) {
+      return base::Value(value);
+    } else if constexpr (std::is_arithmetic_v<V> || std::is_enum_v<V>) {
+      const double number = static_cast<double>(value);
+      if (!std::isfinite(number) || std::abs(number) > 9007199254740991.0) {
+        command.error = "Nonrepresentable WebGL argument";
+        return base::Value();
+      }
+      return base::Value(number);
+    } else if constexpr (std::is_convertible_v<const V&, String>) {
+      std::string text = static_cast<String>(value).Utf8();
+      command.input_bytes += text.size();
+      if (text.size() > 1024 * 1024 || command.input_bytes > 4 * 1024 * 1024) {
+        command.error = "WebGL string budget exceeded";
+        return base::Value();
+      }
+      return base::Value(std::move(text));
+    } else if constexpr (std::is_pointer_v<V>) {
+      using Element = std::remove_cv_t<std::remove_pointer_t<V>>;
+      if (!value)
+        return base::Value();
+      if constexpr (std::is_convertible_v<V, const DOMArrayBufferView*>) {
+        return View(command, *value);
+      } else if constexpr (std::is_convertible_v<V,
+                                                 const DOMArrayBufferBase*>) {
+        return Bytes(command, "ArrayBuffer", value->ByteSpanMaybeShared());
+      } else if constexpr (std::is_convertible_v<V, const WebGLObject*> ||
+                           std::is_same_v<Element, WebGLUniformLocation> ||
+                           std::is_convertible_v<V, const WebGLExtension*>) {
+        return Reference(command, value);
+      }
+      command.texture_source = true;
+      command.error = "WebGL source argument requires command transport";
+      return base::Value();
+    } else if constexpr (requires { value.Get(); }) {
+      return Encode(command, value.Get());
+    } else if constexpr (requires {
+                           value.has_value();
+                           *value;
+                         }) {
+      return value.has_value() ? Encode(command, *value) : base::Value();
+    } else if constexpr (requires {
+                           typename V::value_type;
+                           value.data();
+                           value.size();
+                         }) {
+      using Element = std::remove_cv_t<typename V::value_type>;
+      if constexpr (std::is_arithmetic_v<Element>) {
+        std::string_view type;
+        if constexpr (std::is_same_v<Element, float>)
+          type = "Float32Array";
+        else if constexpr (std::is_same_v<Element, double>)
+          type = "Float64Array";
+        else if constexpr (sizeof(Element) == 4)
+          type = std::is_signed_v<Element> ? "Int32Array" : "Uint32Array";
+        else if constexpr (sizeof(Element) == 2)
+          type = std::is_signed_v<Element> ? "Int16Array" : "Uint16Array";
+        else if constexpr (sizeof(Element) == 1)
+          type = std::is_signed_v<Element> ? "Int8Array" : "Uint8Array";
+        if (!type.empty()) {
+          if constexpr (std::has_unique_object_representations_v<Element>)
+            return Bytes(command, type, base::as_byte_span(value));
+          else
+            return Bytes(command, type,
+                         base::as_byte_span(base::allow_nonunique_obj, value));
+        }
+      }
+      return Sequence(command, value);
+    } else if constexpr (requires {
+                           value.begin();
+                           value.end();
+                           value.size();
+                         }) {
+      return Sequence(command, value);
+    } else {
+      command.error = "Unsupported converted WebGL argument";
+      return base::Value();
+    }
+  }
+
+  template <typename T>
+  base::Value Sequence(ReachWebGLCommand& command, const T& values) {
+    if (values.size() > 16384) {
+      command.error = "WebGL argument list budget exceeded";
+      return base::Value();
+    }
+    base::ListValue result;
+    for (const auto& value : values)
+      result.Append(Encode(command, value));
+    return base::Value(std::move(result));
+  }
+
+  WeakPersistent<WebGLRenderingContextBase> context_;
+  WeakPersistent<HTMLCanvasElement> element_;
+  const uint64_t id_;
+  const uint64_t generation_;
+  std::map<const ScriptWrappable*, Identity> identities_;
+  uint32_t next_identity_ = 1;
+  std::vector<std::string> commands_;
+  size_t bytes_ = 0;
+  std::string error_;
+  ReachWebGLCommand* pending_ = nullptr;
+};
