+  }
+  void TextureUpload(base::ListValue, unsigned, base::span<const uint8_t>);
+  void RejectTextureUpload(std::string_view);
+
+  template <typename T>
+  void Argument(ReachWebGLCommand& command,
+                base::ListValue& args,
+                const T& value) {
+    using V = std::remove_cvref_t<T>;
+    if constexpr (std::is_same_v<V, ExceptionState> ||
+                  std::is_same_v<V, v8::Isolate*> ||
+                  std::is_same_v<V, ScriptState*>) {
+      return;
+    } else {
+      args.Append(Encode(command, value));
+    }
+  }
+
+ private:
+  struct Identity {
+    WeakPersistent<const ScriptWrappable> object;
+    uint32_t id;
+  };
+
+  base::Value Bytes(ReachWebGLCommand&,
+                    std::string_view,
