+class MODULES_EXPORT ReachWebGLJournal final {
+ public:
+  class CommandScope {
+   public:
+    CommandScope(ReachWebGLJournal* journal, ReachWebGLCommand* command)
+        : journal_(journal),
+          previous_(journal ? std::exchange(journal->pending_, command)
+                            : nullptr) {}
+    CommandScope(const CommandScope&) = delete;
+    CommandScope& operator=(const CommandScope&) = delete;
+    ~CommandScope() {
+      if (journal_)
+        journal_->pending_ = previous_;
+    }
+
+   private:
+    ReachWebGLJournal* journal_;
+    ReachWebGLCommand* previous_;
+  };
+
+  explicit ReachWebGLJournal(WebGLRenderingContextBase&);
+  ~ReachWebGLJournal();
+
+  static ReachWebGLJournal* Find(uint64_t);
+  static bool ShouldRecord(std::string_view);
+  bool usable() const { return error_.empty(); }
+  const std::string& error() const { return error_; }
+  uint64_t generation() const { return generation_; }
+  HTMLCanvasElement* element() const;
+  std::string State();
+  std::string Read(uint64_t cursor,
+                   size_t max_bytes,
+                   std::vector<uint8_t>* output) const;
+  void Append(ReachWebGLCommand);
+  void Resize(int width, int height);
+  void Discard();
+  void Extension(const String&, WebGLExtension*);
+  void Program(ReachWebGLCommand&, WebGLProgram*);
+  void Result(ReachWebGLCommand&, const ScriptWrappable*);
+  void Result(ReachWebGLCommand&, uint32_t);
+  void Target(ReachWebGLCommand&, WebGLExtension*);
