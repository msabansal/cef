@@ -0,0 +1,50 @@
+import ast
+from pathlib import Path
+from types import SimpleNamespace
+import unittest
+
+
+class ReachWebGLBindingTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        source = Path(__file__).with_name("interface.py")
+        tree = ast.parse(source.read_text(encoding="utf-8"))
+        helper = next(node for node in tree.body
+                      if isinstance(node, ast.FunctionDef)
+                      and node.name == "_reach_webgl_api_call")
+        namespace = {
+            "CodeGenAccumulator":
+                SimpleNamespace(require_include_headers=tuple),
+        }
+        exec(compile(ast.Module(body=[helper], type_ignores=[]), str(source),
+                     "exec"), namespace)
+        cls.wrap_call = staticmethod(namespace["_reach_webgl_api_call"])
+
+    def generate(self, identifier):
+        context = SimpleNamespace(
+            interface=SimpleNamespace(identifier=identifier),
+            operation=True,
+            attribute_set=False,
+            member_like=SimpleNamespace(is_static=False))
+        node = SimpleNamespace(accumulate=lambda headers: None)
+        return self.wrap_call(node, context, "clear", ["mask"])
+
+    def test_experimental_backend_is_not_instrumented_as_legacy_webgl(self):
+        for identifier in ("WebGLRenderingContextWebGPU",
+                           "WebGL2RenderingContextWebGPU"):
+            with self.subTest(identifier=identifier):
+                self.assertIsNone(self.generate(identifier))
+
+    def test_legacy_contexts_and_extensions_keep_converted_arguments(self):
+        for identifier in ("WebGLRenderingContext", "WebGL2RenderingContext",
+                           "ANGLEInstancedArrays", "OESVertexArrayObject"):
+            with self.subTest(identifier=identifier):
+                expression = self.generate(identifier)
+                self.assertIsNotNone(expression)
+                self.assertTrue(expression.startswith(
+                    'ReachInvokeWebGL(${blink_receiver}, "clear", '))
+                self.assertTrue(expression.endswith(", mask)"))
+
+
+if __name__ == "__main__":
+    unittest.main()
