+TEST_F(FindBufferTest, AsyncFindDirtyActivatableDisplayLocks) {
+  SetBodyContent(R"HTML(
+    <div style="content-visibility:hidden"><span>needle</span></div>
+    <div style="height:30000px"></div>
+    <div id="locked" style="content-visibility:auto">
+      <span id="target">needle</span>
+    </div>
+  )HTML");
+  Document& document = GetDocument();
+  auto* locked = GetElementById("locked");
+  auto* target = GetElementById("target");
+  {
+    auto forced_activatable_locks =
+        document.GetDisplayLockDocumentState().GetScopedForceActivatableLocks();
+    UpdateAllLifecyclePhasesForTest();
+  }
+  UpdateAllLifecyclePhasesForTest();
+  ASSERT_TRUE(locked->GetDisplayLockContext());
+  ASSERT_TRUE(locked->GetDisplayLockContext()->IsLocked());
+  ASSERT_TRUE(target->GetComputedStyle());
+  ASSERT_TRUE(target->firstChild()->GetLayoutObject());
+
+  Persistent<AsyncFindBuffer> finder = MakeGarbageCollected<AsyncFindBuffer>();
+  for (int iteration = 0; iteration < 3; ++iteration) {
+    target->setAttribute(html_names::kStyleAttr,
+                         AtomicString(iteration % 2 ? "color:blue" : "color:red"));
+    document.UpdateStyleAndLayout(DocumentUpdateReason::kFindInPage);
+    // Model a queued search after a document-wide update skipped this dirty
+    // activatable subtree. This is EnsureComputedStyle's actual precondition.
+    ASSERT_TRUE(
+        document.NeedsLayoutTreeUpdateForNodeIncludingDisplayLocked(*target));
+    const auto range = WholeDocumentRange();
+    Persistent<RangeInFlatTree> search_range =
+        MakeGarbageCollected<RangeInFlatTree>(range.StartPosition(),
+                                              range.EndPosition());
+    bool complete = false;
+    finder->FindMatchInRange(
+        search_range.Get(), "needle", FindOptions(),
+        base::BindLambdaForTesting([&](const EphemeralRangeInFlatTree& match) {
+          complete = true;
+          // The non-activatable content-visibility:hidden match stays excluded.
+          EXPECT_EQ(EphemeralRangeInFlatTree(PositionFromParentId("target", 0),
+                                             PositionFromParentId("target", 6)),
+                    match);
+        }));
+    EXPECT_FALSE(complete);
+    test::RunPendingTasks();
+    ASSERT_TRUE(complete);
+    EXPECT_FALSE(finder->IsActive());
+    EXPECT_TRUE(locked->GetDisplayLockContext()->IsLocked());
+  }
+}
