+DispatchResponse NetworkHandler::CancelWireNetworkResource(
+    const String& request_id) {
+  if (request_id.empty() || request_id.size() > 64) {
+    return Response::InvalidParams("Invalid wire request id");
+  }
+  for (auto it = loaders_.begin(); it != loaders_.end(); ++it) {
+    if (it->first->wire_request_id() == request_id) {
+      it->second->sendFailure(
+          Response::ServerError("Encoded media request canceled"));
+      loaders_.erase(it);
+      break;
+    }
+  }
+  return Response::Success();
+}
