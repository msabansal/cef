+// Reach command mode holds begin frames, so the compositor never asks for a
+// main frame. A registered hook instead learns that a local root needs a
+// visual update, letting the embedder schedule its next drawing capture.
+void (*g_reach_frame_request_hook)(LocalFrame&) = nullptr;
+
+}  // namespace
