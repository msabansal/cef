+void GrRecordingContextPriv::maybeFlushForPictureShaderBytes() {
+    GrRecordingContext* context = this->context();
+    const size_t threshold = this->options().fPictureShaderPendingBytesFlushThreshold;
+    if (threshold == 0 || context->fPictureShaderBuildDepth != 0 ||
+        context->fDeviceDrawDepth != 0 || context->fPendingPictureShaderBytes < threshold) {
+        return;
+    }
+    GrDirectContext* direct = context->asDirectContext();
+    if (!direct || direct->abandoned()) {
+        return;
+    }
+    // On-flush callbacks must not re-enter this policy while resources are being submitted.
+    AutoPictureShaderBuild buildGuard(context);
+    AutoDeviceDraw drawGuard(context);
+    direct->flushAndSubmit(GrSyncCpu::kYes);
+}
