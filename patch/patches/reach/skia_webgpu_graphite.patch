+// Overrides Emscripten 4.0.7 -sUSE_WEBGPU entry points that break Graphite:
+//
+// Draw calls: WASM passes uint32_t arguments as signed i32, so values >= 2^31 reach WebIDL
+// [EnforceRange] unsigned long parameters as negative numbers and throw. Graphite's Dawn blit
+// (DawnResourceProvider::BlitWithDrawEncoder) packs a negative 16-bit y offset into the high bits
+// of firstInstance, so convert every unsigned argument with `>>> 0`. baseVertex is a signed long
+// in WebGPU and stays as is.
+addToLibrary({
+  wgpuRenderPassEncoderDraw__deps: ['$WebGPU'],
+  wgpuRenderPassEncoderDraw: (passId, vertexCount, instanceCount, firstVertex, firstInstance) => {
+    var pass = WebGPU.mgrRenderPassEncoder.get(passId);
+    pass.draw(vertexCount >>> 0, instanceCount >>> 0, firstVertex >>> 0, firstInstance >>> 0);
+  },
+  wgpuRenderPassEncoderDrawIndexed__deps: ['$WebGPU'],
+  wgpuRenderPassEncoderDrawIndexed: (passId, indexCount, instanceCount, firstIndex, baseVertex, firstInstance) => {
+    var pass = WebGPU.mgrRenderPassEncoder.get(passId);
+    pass.drawIndexed(indexCount >>> 0, instanceCount >>> 0, firstIndex >>> 0, baseVertex,
+                     firstInstance >>> 0);
+  },
+  wgpuRenderBundleEncoderDraw__deps: ['$WebGPU'],
+  wgpuRenderBundleEncoderDraw: (bundleId, vertexCount, instanceCount, firstVertex, firstInstance) => {
+    var bundle = WebGPU.mgrRenderBundleEncoder.get(bundleId);
+    bundle.draw(vertexCount >>> 0, instanceCount >>> 0, firstVertex >>> 0, firstInstance >>> 0);
+  },
+  wgpuRenderBundleEncoderDrawIndexed__deps: ['$WebGPU'],
+  wgpuRenderBundleEncoderDrawIndexed: (bundleId, indexCount, instanceCount, firstIndex, baseVertex, firstInstance) => {
+    var bundle = WebGPU.mgrRenderBundleEncoder.get(bundleId);
+    bundle.drawIndexed(indexCount >>> 0, instanceCount >>> 0, firstIndex >>> 0, baseVertex,
+                       firstInstance >>> 0);
+  },
