+  // destroyed skips the copy: destroy() detaches the mapped ArrayBuffer and constructing a view
+  // on it throws, which would escape from Graphite's buffer cleanup.
+  wgpuBufferGetMappedRange__deps: ['$WebGPU', '$zeroMemory', 'memalign', 'free'],
+  wgpuBufferGetMappedRange: (bufferId, offset, size) => {
+    var bufferWrapper = WebGPU.mgrBuffer.objects[bufferId];
+    if (size == -1) size = undefined;
+    if (bufferWrapper.mapMode !== 2 /* WGPUMapMode_Write */) {
+      return 0;
+    }
+    var mapped;
+    try {
+      mapped = bufferWrapper.object.getMappedRange(offset, size);
+    } catch (ex) {
+      return 0;
+    }
+    var length = mapped.byteLength;
+    var data = _memalign(16, length);
+    zeroMemory(data, length);
+    bufferWrapper.onUnmap.push(() => {
