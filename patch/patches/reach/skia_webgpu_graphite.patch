+// One Graphite Context and Recorder per GPUDevice. Every surface and image created for the device
+// records into the same Recorder; Surface.flush() snaps and submits it. The Context is
+// non-yielding (no DawnTickFunction), so GPU completion is observed from the browser event loop
+// through checkAsyncWorkCompletion() and pixel reads are asynchronous.
+struct WebGPUDeviceContext {
+    struct PendingRead {
+        bool done = false;
+        bool ok = false;
+        size_t rowBytes = 0;
+        int height = 0;
+        std::vector<uint8_t> pixels;
+    };
+
+    std::unique_ptr<skgpu::graphite::Context> context;
+    std::unique_ptr<skgpu::graphite::Recorder> recorder;
+    std::map<uint32_t, std::unique_ptr<PendingRead>> reads;
+    uint32_t nextRead = 1;
+
+    ~WebGPUDeviceContext();
+    bool flush();
+};
+
+static std::map<const skgpu::graphite::Recorder*, WebGPUDeviceContext*>& WebGPUContexts() {
+    static auto* contexts = new std::map<const skgpu::graphite::Recorder*, WebGPUDeviceContext*>();
+    return *contexts;
+}
+
+WebGPUDeviceContext::~WebGPUDeviceContext() {
+    WebGPUContexts().erase(recorder.get());
+    recorder.reset();
+    // Graphite aborts when a non-yielding Context is destroyed with GPU work in flight. JS delete()
+    // waits for that work first; if it is still unfinished here (e.g. the device was lost and never
+    // reported completion) leak the Context rather than abort the module.
+    context->checkAsyncWorkCompletion();
+    if (context->hasUnfinishedGpuWork()) {
+        SKIA_LOG_W("Leaking a WebGPU Graphite context with unfinished GPU work");
+        (void)context.release();
+        return;
+    }
+    context.reset();
+}
+
+bool WebGPUDeviceContext::flush() {
+    std::unique_ptr<skgpu::graphite::Recording> recording = recorder->snap();
+    if (!recording) {
+        return false;
+    }
+    skgpu::graphite::InsertRecordingInfo info;
+    info.fRecording = recording.get();
+    bool inserted = context->insertRecording(info) == skgpu::graphite::InsertStatus::kSuccess;
+    context->submit();
+    context->checkAsyncWorkCompletion();
+    return inserted;
+}
+
+static bool FlushWebGPU(const skgpu::graphite::Recorder* recorder) {
+    auto found = WebGPUContexts().find(recorder);
+    return found != WebGPUContexts().end() && found->second->flush();
+}
+
+// Graphite only draws Graphite-backed images unless the Recorder has an ImageProvider. This one
+// uploads raster and lazy (encoded) images and keeps the textures in a byte-bounded LRU keyed by
+// image unique ID, so pictures redrawn every frame reuse their uploads.
+class CanvasKitImageProvider final : public skgpu::graphite::ImageProvider {
+public:
+    static constexpr size_t kBudgetBytes = 128 * 1024 * 1024;
+
+    sk_sp<SkImage> findOrCreate(skgpu::graphite::Recorder* recorder,
+                                const SkImage* image,
+                                SkImage::RequiredProperties props) override {
+        const uint64_t key = (static_cast<uint64_t>(image->uniqueID()) << 1) | props.fMipmapped;
+        auto found = fEntries.find(key);
+        if (found != fEntries.end()) {
+            fLru.splice(fLru.begin(), fLru, found->second);
+            return found->second->texture;
+        }
+        sk_sp<SkImage> texture = SkImages::TextureFromImage(recorder, image, props);
+        if (!texture) {
+            return nullptr;
+        }
+        const size_t bytes = texture->imageInfo().computeMinByteSize() * (props.fMipmapped ? 4 : 3) / 3;
+        fLru.push_front({key, texture, bytes});
+        fEntries[key] = fLru.begin();
+        fBytes += bytes;
+        while (fBytes > kBudgetBytes && fLru.size() > 1) {
+            fBytes -= fLru.back().bytes;
+            fEntries.erase(fLru.back().key);
+            fLru.pop_back();
+        }
+        return texture;
+    }
+
+private:
+    struct Entry {
+        uint64_t key;
+        sk_sp<SkImage> texture;
+        size_t bytes;
+    };
+    std::list<Entry> fLru;
+    std::map<uint64_t, std::list<Entry>::iterator> fEntries;
+    size_t fBytes = 0;
+};
