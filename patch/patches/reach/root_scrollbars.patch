+bool ShouldHideScrollbars(const LayoutBox& box) {
+  const auto* frame = box.GetFrame();
+  if (frame->GetSettings()->GetHideScrollbars()) {
+    return true;
+  }
+  if (!box.IsLayoutView() || !frame->IsMainFrame()) {
+    return false;
+  }
+  // Root scrollbar modes also determine UserInputScrollable. Suppress only
+  // scrollbar creation and reserved space, not native scrolling permission.
+  const auto* command_line = base::CommandLine::ForCurrentProcess();
+  return command_line->HasSwitch("reach-drawing-commands") ||
+         command_line->HasSwitch("reach-video-sink");
+}
