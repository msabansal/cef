+void SoftwareRenderer::InvalidateRenderPassFilter(
+    RenderPassBitmapBacking& backing) {
+  if (!backing.filtered) {
+    return;
+  }
+  render_pass_filter_cache_bytes_ -=
+      backing.filtered->image->imageInfo().computeMinByteSize();
+  --render_pass_filter_cache_entries_;
+  backing.filtered.reset();
+}
+
+sk_sp<SkImage> SoftwareRenderer::ApplyRenderPassFilter(
+    SkImageFilter* filter,
+    const AggregatedRenderPassDrawQuad* quad,
+    const SkBitmap& source,
+    SkIRect* result_rect) {
+  const SkIRect needed_rect = GetImageFilterBounds(
+      filter, quad, settings_->cache_render_pass_filters);
+  if (needed_rect.isEmpty()) {
+    *result_rect = needed_rect;
+    return nullptr;
+  }
+  auto it = render_pass_bitmaps_.find(quad->render_pass_id);
+  // Reference filters can retain arbitrary external resources. Cache only
+  // self-contained operations and owned render-pass backings.
+  const bool can_cache = settings_->cache_render_pass_filters &&
+                         !quad->filters.HasReferenceFilter() &&
+                         it != render_pass_bitmaps_.end();
+  if (can_cache) {
+    const auto& cached = it->second.filtered;
+    if (cached && cached->filters == quad->filters &&
+        cached->rect == quad->rect &&
+        cached->origin == quad->filters_origin &&
+        cached->scale == quad->filters_scale &&
+        cached->result_rect.contains(needed_rect)) {
+      TRACE_EVENT0("viz", "SoftwareRenderer::RenderPassFilterCacheHit");
+      ++render_pass_filter_cache_hits_;
+      *result_rect = cached->result_rect;
+      return cached->image;
+    }
+    InvalidateRenderPassFilter(it->second);
+  }
+
+  TRACE_EVENT2("viz", "SoftwareRenderer::ApplyRenderPassFilter",
+               "filters", quad->filters.ToString(),
+               "raster_rect", gfx::SkIRectToRect(needed_rect).ToString());
+  auto image = ApplyImageFilter(filter, quad, source,
+                               /*offset_expanded_bounds=*/true, result_rect);
+  constexpr size_t kMaxCacheBytes = 64 * 1024 * 1024;
+  constexpr size_t kMaxCacheEntries = 32;
+  if (!can_cache || !image ||
+      image->imageInfo().computeMinByteSize() > kMaxCacheBytes) {
+    return image;
+  }
+  const size_t bytes = image->imageInfo().computeMinByteSize();
+  if (render_pass_filter_cache_bytes_ > kMaxCacheBytes - bytes ||
+      render_pass_filter_cache_entries_ == kMaxCacheEntries) {
+    for (auto& [id, backing] : render_pass_bitmaps_) {
+      InvalidateRenderPassFilter(backing);
+    }
+  }
+  it->second.filtered = std::make_unique<FilteredRenderPass>(
+      quad->filters, quad->rect, quad->filters_origin, quad->filters_scale,
+      *result_rect, image);
+  render_pass_filter_cache_bytes_ += bytes;
+  ++render_pass_filter_cache_entries_;
+  return image;
+}
+
+SkIRect SoftwareRenderer::GetImageFilterBounds(
+    SkImageFilter* filter,
+    const AggregatedRenderPassDrawQuad* quad,
+    bool clip_to_current_canvas) const {
+  SkMatrix local_matrix;
+  local_matrix.setTranslate(quad->filters_origin.x(), quad->filters_origin.y());
+  local_matrix.postScale(quad->filters_scale.x(), quad->filters_scale.y());
+  SkIRect bounds = filter->filterBounds(gfx::RectToSkIRect(quad->rect),
+                                      local_matrix,
+                                      SkImageFilter::kForward_MapDirection);
+  // Masks map their texture over the complete filtered output bounds.
+  if (clip_to_current_canvas && !quad->mask_resource_id() &&
+      !current_canvas_->getTotalMatrix().hasPerspective()) {
+    // SkCanvas conservatively maps the device clip, including its AA fringe.
+    // Keep the complete source; Skia expands input bounds for the filter halo.
+    SkRect clip;
+    if (!current_canvas_->getLocalClipBounds(&clip) ||
+        !bounds.intersect(clip.roundOut())) {
+      return SkIRect::MakeEmpty();
+    }
+  }
+  return bounds;
+}
