+class SoftwareRendererFilterCacheTest : public SoftwareRendererTest {
+ public:
+  void SetUp() override {
+    renderer_settings_.cache_render_pass_filters = true;
+    renderer_settings_.partial_swap_enabled = true;
+    renderer_settings_.disable_render_pass_bypassing = true;
+    SoftwareRendererTest::SetUp();
+  }
+
+  void DrawFiltered(const gfx::Rect& damage,
+                    SkColor4f source,
+                    float brightness,
+                    std::vector<ExpectedImageRect> expected) {
+    AggregatedRenderPassList list;
+    const gfx::Rect bounds(20, 20, 60, 60);
+    auto* child = cc::AddRenderPass(
+        &list, AggregatedRenderPassId{2}, bounds, gfx::Transform());
+    child->damage_rect = damage;
+    child->has_damage_from_contributing_content = !damage.IsEmpty();
+    cc::AddQuad(child, bounds, source);
+    auto* root = cc::AddRenderPass(&list, AggregatedRenderPassId{1},
+                                  gfx::Rect(100, 100), gfx::Transform());
+    auto* quad = cc::AddRenderPassQuad(root, child);
+    quad->filters.Append(
+        cc::FilterOperation::CreateBrightnessFilter(brightness));
+    cc::AddQuad(root, gfx::Rect(100, 100), SkColors::kGreen);
+    expected.insert(expected.begin(),
+                    {.rect = gfx::Rect(100, 100), .color = SkColors::kGreen});
+    ASSERT_TRUE(RunPixelTest(
+        &list, GenerateExpectedImage(gfx::Size(100, 100), std::move(expected)),
+        cc::ExactPixelComparator()));
+  }
+};
+
+TEST_F(SoftwareRendererFilterCacheTest,
+       ReusesUnchangedSourceAndInvalidatesDamageAndFilterChanges) {
+  const gfx::Rect bounds(20, 20, 60, 60);
+  const gfx::Rect damage(20, 20, 1, 1);
+  DrawFiltered(bounds, SkColors::kRed, 0.5f,
+               {{.rect = bounds, .color = {0.5f, 0.f, 0.f, 1.f}}});
+  EXPECT_EQ(software_renderer_->GetRenderPassFilterCacheHitsForTesting(), 0u);
+  DrawFiltered(gfx::Rect(), SkColors::kRed, 0.5f,
+               {{.rect = bounds, .color = {0.5f, 0.f, 0.f, 1.f}}});
+  EXPECT_EQ(software_renderer_->GetRenderPassFilterCacheHitsForTesting(), 1u);
+
+  DrawFiltered(damage, SkColors::kBlue, 0.5f,
+               {{.rect = bounds, .color = {0.5f, 0.f, 0.f, 1.f}},
+                {.rect = damage, .color = {0.f, 0.f, 0.5f, 1.f}}});
+  EXPECT_EQ(software_renderer_->GetRenderPassFilterCacheHitsForTesting(), 1u);
+  DrawFiltered(gfx::Rect(), SkColors::kBlue, 0.25f,
+               {{.rect = bounds, .color = {0.25f, 0.f, 0.f, 1.f}},
+                {.rect = damage, .color = {0.f, 0.f, 0.25f, 1.f}}});
+  EXPECT_EQ(software_renderer_->GetRenderPassFilterCacheHitsForTesting(), 1u);
+  DrawFiltered(gfx::Rect(), SkColors::kBlue, 0.25f,
+               {{.rect = bounds, .color = {0.25f, 0.f, 0.f, 1.f}},
+                {.rect = damage, .color = {0.f, 0.f, 0.25f, 1.f}}});
+  EXPECT_EQ(software_renderer_->GetRenderPassFilterCacheHitsForTesting(), 2u);
+}
