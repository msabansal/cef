+void WebFrameWidgetImpl::DidCompleteReachCommandCapture() {
+  CHECK(IsMainThread());
+  if (!Canvas2DBitmapProvider::IsReachCommandMode() || !widget_base_ ||
+      !widget_base_->LayerTreeHost()) {
+    return;
+  }
+  // Command capture has no Viz swap. Reuse the existing no-update completion
+  // timestamp; do not report successful hardware presentation feedback.
+  widget_base_->LayerTreeHost()->GetSwapPromiseManager()->BreakSwapPromises(
+      cc::SwapPromise::COMMIT_NO_UPDATE);
+}
