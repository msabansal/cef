+class SortedFrameCollector : public cc::FrameSorterObserver {
+ public:
+  void AddSortedFrame(const BeginFrameArgs&,
+                      const cc::FrameInfo& frame_info) override {
+    frames.push_back(frame_info);
+  }
+
+  std::vector<cc::FrameInfo> frames;
+};
+
+TEST_F(ReachVideoOutputDeviceTest, MainOnlyDroppedBeforeBlinkStarts) {
+  using Reporter = cc::CompositorFrameReporter;
+  constexpr std::array kImplStatuses = {
+      Reporter::FrameTerminationStatus::kPresentedFrame,
+      Reporter::FrameTerminationStatus::kDidNotPresentFrame};
+  constexpr std::array kMainFirst = {false, true};
+
+  for (auto impl_status : kImplStatuses) {
+    for (bool main_first : kMainFirst) {
+      SCOPED_TRACE(testing::Message()
+                   << "impl_status=" << static_cast<int>(impl_status)
+                   << " main_first=" << main_first);
+      base::SimpleTestTickClock clock;
+      clock.SetNowTicks(base::TimeTicks::Now());
+      SortedFrameCollector collector;
+      cc::FrameSorter sorter;
+      sorter.AddObserver(&collector);
+      sorter.OnFirstContentfulPaintReceived();
+      const auto args = BeginFrameArgs::Create(
+          BEGINFRAME_FROM_HERE, 1, 1, clock.NowTicks(),
+          clock.NowTicks() + base::Milliseconds(16), base::Milliseconds(16),
+          BeginFrameArgs::NORMAL);
+      auto make_reporter = [&]() {
+        auto reporter = std::make_unique<Reporter>(
+            cc::ActiveTrackers(), args, /*should_report_histograms=*/false,
+            /*report_event_latency_to_custom_metrics_recorder=*/false,
+            Reporter::SmoothThread::kSmoothBoth,
+            cc::FrameInfo::SmoothEffectDrivingThread::kUnknown,
+            /*layer_tree_host_id=*/1, &sorter);
+        reporter->set_tick_clock(&clock);
+        return reporter;
+      };
+      auto impl_reporter = make_reporter();
+      impl_reporter->StartStage(
+          Reporter::StageType::kBeginImplFrameToSendBeginMainFrame,
+          clock.NowTicks());
+      clock.Advance(base::Microseconds(1));
+      impl_reporter->StartStage(
+          Reporter::StageType::kEndActivateToSubmitCompositorFrame,
+          clock.NowTicks());
+      clock.Advance(base::Microseconds(1));
+      impl_reporter->StartStage(
+          Reporter::StageType::kSubmitCompositorFrameToPresentationCompositorFrame,
+          clock.NowTicks());
+      auto main_reporter = make_reporter();
+      main_reporter->StartStage(
+          Reporter::StageType::kSendBeginMainFrameToCommit, clock.NowTicks());
+      clock.Advance(base::Microseconds(1));
+      auto finish_main = [&]() {
+        main_reporter->TerminateFrame(
+            Reporter::FrameTerminationStatus::kReplacedByNewReporter,
+            clock.NowTicks());
+        main_reporter.reset();
+      };
+      auto finish_impl = [&]() {
+        impl_reporter->TerminateFrame(impl_status, clock.NowTicks());
+        impl_reporter.reset();
+      };
+      if (main_first) {
+        finish_main();
+        finish_impl();
+      } else {
+        finish_impl();
+        finish_main();
+      }
+      ASSERT_EQ(1u, collector.frames.size());
+      EXPECT_EQ(cc::FrameInfo::FrameFinalState::kDropped,
+                collector.frames.front().GetFinalStateForThread(
+                    cc::FrameInfo::SmoothEffectDrivingThread::kMain));
+      EXPECT_EQ(
+          impl_status == Reporter::FrameTerminationStatus::kPresentedFrame
+              ? cc::FrameInfo::FrameFinalState::kPresentedAll
+              : cc::FrameInfo::FrameFinalState::kDropped,
+          collector.frames.front().GetFinalStateForThread(
+              cc::FrameInfo::SmoothEffectDrivingThread::kCompositor));
+    }
+  }
+}
