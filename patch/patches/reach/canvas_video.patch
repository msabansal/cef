+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_REACH_CANVAS_VIDEO_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_REACH_CANVAS_VIDEO_H_
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <limits>
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace blink {
+
+// CPU-owned current content, never a queue of rendered historical frames.
+class ReachCanvasVideo {
+ public:
+  static constexpr uint64_t kMaxCodecBytes = 320 * 1024 * 1024;
+  static constexpr uint64_t kStreamCodecBytes = 4 * 1024 * 1024;
+  static constexpr unsigned kMaxStreams =
+      kMaxCodecBytes / (16 * 16 * 64 + kStreamCodecBytes);
+
+  struct Inventory {
+    bool Add(int width, int height) {
+      if (width < 1 || height < 1 || width > 3840 || height > 2160)
+        return false;
+      const uint64_t even = uint64_t((width + 1) & ~1) * ((height + 1) & ~1);
+      const uint64_t coded =
+          uint64_t((width + 15) & ~15) * ((height + 15) & ~15);
+      if (pixels + even > 4194304 ||
+          codec + coded * 64 + kStreamCodecBytes > kMaxCodecBytes)
+        return false;
+      ++count;
+      pixels += even;
+      codec += coded * 64 + kStreamCodecBytes;
+      return true;
+    }
+    unsigned count = 0;
+    uint64_t pixels = 0;
+    uint64_t codec = 0;
+  };
+
+  struct Budget {
+    bool Admit(uint64_t stream, int width, int height) {
+      Inventory inventory;
+      for (const auto& [id, size] : active) {
+        if (id != stream && !inventory.Add(size.first, size.second))
+          return false;
+      }
+      if (!inventory.Add(width, height))
+        return false;
+      active[stream] = {width, height};
+      return true;
+    }
+    std::map<uint64_t, std::pair<int, int>> active;
+  };
+
+  static std::optional<std::vector<std::pair<int, int>>> Plan(
+      const std::vector<std::pair<int, int>>& sources) {
+    if (sources.size() > kMaxStreams)
+      return std::nullopt;
+    // Source bounds match decoded images, not the smaller exported samples.
+    constexpr int kMaxSourceEdge = 8192;
+    constexpr uint64_t kMaxSourcePixels = 16 * 1024 * 1024;
+    for (const auto& [width, height] : sources) {
+      if (width < 1 || height < 1 || width > kMaxSourceEdge ||
+          height > kMaxSourceEdge || uint64_t(width) * height > kMaxSourcePixels)
+        return std::nullopt;
+    }
+    // A scale step changes every supported source dimension by at most
+    // one pixel. Search admission directly, including codec block padding.
+    constexpr int kScaleUnits = kMaxSourceEdge;
+    int lower = 0;
+    int upper = kScaleUnits;
+    std::optional<std::vector<std::pair<int, int>>> best;
+    while (lower <= upper) {
+      const int scale = lower + (upper - lower) / 2;
+      Inventory inventory;
+      std::vector<std::pair<int, int>> planned;
+      for (const auto& [width, height] : sources) {
+        const int w = std::max(1, width * scale / kScaleUnits);
+        const int h = std::max(1, height * scale / kScaleUnits);
+        if (!inventory.Add(w, h))
+          break;
+        planned.emplace_back(w, h);
+      }
+      if (planned.size() == sources.size()) {
+        best = std::move(planned);
+        lower = scale + 1;
+      } else {
+        upper = scale - 1;
+      }
+    }
+    return best;
+  }
+
+  ReachCanvasVideo() : stream_(AllocateStream()) {
+    if (!stream_)
+      Fail("WebGL video stream identity exhausted");
+  }
+  ~ReachCanvasVideo() { ReleaseBudget(); }
+  ReachCanvasVideo(const ReachCanvasVideo&) = delete;
+  ReachCanvasVideo& operator=(const ReachCanvasVideo&) = delete;
+
+  void SetBudget(std::shared_ptr<Budget> budget) {
+    if (budget_ != budget) {
+      ReleaseBudget();
+      budget_ = std::move(budget);
+      Epoch();
+    }
+  }
+  void ReleaseAdmission() { ReleaseBudget(); }
+  bool IsCurrent() const {
+    return error_.empty() && captured_ == revision_ && !rgba_.empty();
+  }
+  void Dirty() {
+    if (revision_ == std::numeric_limits<uint64_t>::max()) {
+      Fail("WebGL video content revision exhausted");
+      return;
+    }
+    ++revision_;
+  }
+  void Epoch() {
+    ReleaseBudget();
+    rgba_.clear();
+    rgba_.shrink_to_fit();
+    if (generation_ == std::numeric_limits<uint64_t>::max()) {
+      Fail("WebGL video generation exhausted");
+      return;
+    }
+    ++generation_;
+    error_.clear();
+    Dirty();
+  }
+  bool Fail(std::string error) {
+    error_ = std::move(error);
+    rgba_.clear();
+    rgba_.shrink_to_fit();
+    return false;
+  }
+
+  template <typename Read>
+  bool Checkpoint(int width, int height, Read read) {
+    if (!stream_)
+      return Fail("WebGL video stream identity exhausted");
+    if (!error_.empty())
+      return false;
+    Inventory dimensions;
+    if (!dimensions.Add(width, height))
+      return Fail("WebGL video dimensions or aggregate budget exceeded");
+    if (width_ != width || height_ != height) {
+      if (width_)
+        Epoch();
+      width_ = width;
+      height_ = height;
+    }
+    if (budget_ && !budget_->Admit(stream_, width, height))
+      return Fail("WebGL video dimensions or aggregate budget exceeded");
+    if (captured_ == revision_ && !rgba_.empty())
+      return true;
+    if (sequence_ == std::numeric_limits<uint64_t>::max())
+      return Fail("WebGL video sequence exhausted");
+    const uint64_t revision = revision_;
+    auto bytes = read();
+    if (!error_.empty())
+      return false;
+    if (bytes.size() != uint64_t(width) * height * 4 || revision != revision_)
+      return Fail("WebGL video snapshot truncated or context changed");
+    rgba_ = std::move(bytes);
+    captured_ = revision;
+    ++sequence_;
+    return true;
+  }
+
+  uint64_t stream() const { return stream_; }
+  uint64_t generation() const { return generation_; }
+  uint64_t sequence() const { return sequence_; }
+  int width() const { return width_; }
+  int height() const { return height_; }
+  const std::vector<uint8_t>& rgba() const { return rgba_; }
+  const std::string& error() const { return error_; }
+
+ private:
+  static std::atomic_uint64_t& NextStream() {
+    static std::atomic_uint64_t next{1};
+    return next;
+  }
+  static uint64_t AllocateStream() {
+    auto& next = NextStream();
+    uint64_t value = next.load();
+    while (value && value != std::numeric_limits<uint64_t>::max()) {
+      if (next.compare_exchange_weak(value, value + 1))
+        return value;
+    }
+    return 0;
+  }
+  void ReleaseBudget() {
+    if (budget_)
+      budget_->active.erase(stream_);
+  }
+  const uint64_t stream_;
+  uint64_t generation_ = 1;
+  uint64_t sequence_ = 0;
+  uint64_t revision_ = 1;
+  uint64_t captured_ = 0;
+  int width_ = 0;
+  int height_ = 0;
+  std::shared_ptr<Budget> budget_;
+  std::vector<uint8_t> rgba_;
+  std::string error_;
+};
+
+}  // namespace blink
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_REACH_CANVAS_VIDEO_H_
