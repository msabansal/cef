+
+void CanvasRenderingContext::SetReachCanvasVideoChangeCallback(
+    void (*callback)(HTMLCanvasElement*)) {
+  reach_canvas_video_change_callback = callback;
+}
+
+void CanvasRenderingContext::ReachCanvasVideoChanged(bool epoch) {
+  if (!Canvas2DBitmapProvider::IsReachCanvasVideoMode() ||
+      !Host() || Host()->IsOffscreenCanvas())
+    return;
+  auto* canvas = static_cast<HTMLCanvasElement*>(Host());
+  if (!canvas->isConnected()) {
+    ReleaseReachCanvasVideo();
+    return;
+  }
+  if (!reach_canvas_video_) {
+    reach_canvas_video_ = std::make_unique<ReachCanvasVideo>();
+    // Replace any cached paint recorded while this context was lost.
+    if (auto* layout = canvas->GetLayoutObject())
+      layout->SetShouldDoFullPaintInvalidation();
+  }
+  if (epoch)
+    reach_canvas_video_->Epoch();
+  else
+    reach_canvas_video_->Dirty();
+  if (reach_canvas_video_change_callback)
+    reach_canvas_video_change_callback(static_cast<HTMLCanvasElement*>(Host()));
+}
+
+gfx::Size CanvasRenderingContext::ReachCanvasVideoSize() const {
+  return Host() ? Host()->Size() : gfx::Size();
+}
+
+void CanvasRenderingContext::PrepareReachCanvasVideoCapture(
+    const gfx::Size& size) {
+  reach_canvas_video_capture_prepared_ = !size.IsEmpty();
+  reach_canvas_video_capture_size_ = size;
+  if (reach_canvas_video_)
+    reach_canvas_video_->ReleaseAdmission();
+}
+
+void CanvasRenderingContext::ReleaseReachCanvasVideo() {
+  reach_canvas_video_capture_prepared_ = false;
+  if (!reach_canvas_video_)
+    return;
+  if (Host() && !Host()->IsOffscreenCanvas()) {
+    auto* canvas = static_cast<HTMLCanvasElement*>(Host());
+    // Cached paint must not retain the retired stream's marker.
+    if (auto* layout = canvas->GetLayoutObject())
+      layout->SetShouldDoFullPaintInvalidation();
+    if (reach_canvas_video_change_callback)
+      reach_canvas_video_change_callback(canvas);
+  }
+  reach_canvas_video_.reset();
+}
+
+bool CanvasRenderingContext::CheckpointReachCanvasVideo() {
+  if (!Canvas2DBitmapProvider::IsReachCanvasVideoMode())
+    return true;
+  // Only a preflighted painted inventory may read or admit new pixels.
+  if (!reach_canvas_video_capture_prepared_)
+    return reach_canvas_video_ && reach_canvas_video_->IsCurrent();
+  reach_canvas_video_capture_prepared_ = false;
+  if (!Host() || Host()->IsOffscreenCanvas())
+    return false;
+  auto* canvas = static_cast<HTMLCanvasElement*>(Host());
+  auto* frame = canvas->GetDocument().GetFrame();
+  if (!canvas->isConnected() || !frame || !frame->IsAttached()) {
+    ReleaseReachCanvasVideo();
+    return false;
+  }
+  if (!reach_canvas_video_)
+    ReachCanvasVideoChanged();
+  auto& capture = *reach_canvas_video_;
+  if (frame->LocalFrameRoot().Tree().Parent())
+    return capture.Fail("Out-of-process canvas video is unsupported");
+  if (isContextLost())
+    return capture.Fail("Canvas video context is lost");
+  if (!ReachCanvasVideoIsSDR())
+    return capture.Fail("HDR or F16 canvas video is unsupported");
+  using Budgets =
+      std::map<LocalFrame*, std::weak_ptr<ReachCanvasVideo::Budget>>;
+  static base::NoDestructor<Budgets> budgets;
+  std::erase_if(*budgets,
+                [](const auto& entry) { return entry.second.expired(); });
+  auto& weak = (*budgets)[&frame->LocalFrameRoot()];
+  auto budget = weak.lock();
+  if (!budget) {
+    budget = std::make_shared<ReachCanvasVideo::Budget>();
+    weak = budget;
+  }
+  capture.SetBudget(std::move(budget));
+  const auto size = ReachCanvasVideoSize();
+  const auto output_size = reach_canvas_video_capture_size_;
+  if (size != canvas->Size())
+    return capture.Fail(
+        "Canvas video drawing buffer differs from logical canvas");
+  auto* document = &canvas->GetDocument();
+  return capture.Checkpoint(output_size.width(), output_size.height(), [&] {
+    auto snapshot = IsWebGL()
+                        ? GetRGBAUnacceleratedStaticBitmapImage(kBackBuffer)
+                        : PaintRenderingResultsToSnapshot(kBackBuffer);
+    if (!snapshot || snapshot->GetSize() != size ||
+        snapshot->GetColorSpace().IsHDR() ||
+        snapshot->PaintImageForCurrentFrame().GetColorType() ==
+            kRGBA_F16_SkColorType) {
+      capture.Fail("Canvas video SDR snapshot unavailable");
+      return std::vector<uint8_t>();
+    }
+    const auto info =
+        SkImageInfo::Make(output_size.width(), output_size.height(),
+                          kRGBA_8888_SkColorType,
+                          kUnpremul_SkAlphaType, SkColorSpace::MakeSRGB());
+    std::vector<uint8_t> bytes;
+    if (output_size == size) {
+      const auto original = snapshot->CopyImageData(info, false);
+      bytes.assign(original.begin(), original.end());
+    } else {
+      bytes.resize(info.computeMinByteSize());
+      const auto image = snapshot->PaintImageForCurrentFrame().GetSwSkImage();
+      if (!image ||
+          !image->scalePixels(SkPixmap(info, bytes.data(), info.minRowBytes()),
+                              SkSamplingOptions(SkFilterMode::kLinear))) {
+        capture.Fail("Canvas video bounded resampling failed");
+        return std::vector<uint8_t>();
+      }
+    }
+    if (!canvas->isConnected() || canvas->RenderingContext() != this ||
+        &canvas->GetDocument() != document || !frame->IsAttached() ||
+        isContextLost() || ReachCanvasVideoSize() != size) {
+      capture.Fail("Canvas video context changed during snapshot");
+      return std::vector<uint8_t>();
+    }
+    return bytes;
+  });
 }
 
