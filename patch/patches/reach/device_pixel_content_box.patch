+float DevicePixelContentBoxScale(const LayoutObject& layout_object) {
+  const auto* command_line = base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch("reach-drawing-commands") &&
+      !command_line->HasSwitch("reach-video-sink")) {
+    return 1.0f;
+  }
+  const auto* page = layout_object.GetDocument().GetPage();
+  return page ? page->InspectorDeviceScaleFactorOverride() : 1.0f;
