diff --git components/viz/service/display_embedder/reach_video_output_device.cc components/viz/service/display_embedder/reach_video_output_device.cc
new file mode 100644
--- /dev/null
+++ components/viz/service/display_embedder/reach_video_output_device.cc
@@ -0,0 +1,93 @@
+#include "components/viz/service/display_embedder/reach_video_output_device.h"
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/trace_event/trace_event.h"
+#include "base/unguessable_token.h"
+#include "third_party/skia/include/core/SkColorSpace.h"
+
+namespace viz {
+
+ReachVideoOutputDevice::ReachVideoOutputDevice(
+    mojo::PendingRemote<mojom::ReachVideoSink> sink)
+    : sink_(std::move(sink)) {
+  sink_.set_disconnect_handler(base::BindOnce(
+      &ReachVideoOutputDevice::Fail, weak_factory_.GetWeakPtr(),
+      "Reach video consumer disconnected"));
+  sink_->Started(base::UnguessableToken::Create().ToString());
+}
+
+ReachVideoOutputDevice::~ReachVideoOutputDevice() = default;
+
+void ReachVideoOutputDevice::Resize(const gfx::Size& size, float scale_factor) {
+  if (size == viewport_pixel_size_)
+    return;
+  if (size.IsEmpty() || size.width() > 8192 || size.height() > 8192 ||
+      static_cast<uint64_t>(size.width()) * size.height() > 16 * 1024 * 1024) {
+    Fail("Reach video output dimensions exceed the capture budget");
+    return;
+  }
+  SoftwareOutputDevice::Resize(size, scale_factor);
+  ++generation_;
+  pending_ = false;
+  if (!surface_)
+    Fail("Reach video raster surface allocation failed");
+}
+
+void ReachVideoOutputDevice::EndPaint() {
+  TRACE_EVENT0("viz", "ReachVideoOutputDevice::EndPaint");
+  if (failed_ || !surface_)
+    return;
+  pending_ = true;
+  pending_timestamp_ = base::TimeTicks::Now();
+  DeliverLatest();
+}
+
+void ReachVideoOutputDevice::DeliverLatest() {
+  if (failed_ || in_flight_ || !pending_)
+    return;
+  const uint32_t stride = viewport_pixel_size_.width() * 4;
+  const size_t bytes = static_cast<size_t>(stride) * viewport_pixel_size_.height();
+  if (!snapshot_.mapping.IsValid() || snapshot_.mapping.size() != bytes)
+    snapshot_ = base::ReadOnlySharedMemoryRegion::Create(bytes);
+  if (!snapshot_.IsValid()) {
+    Fail("Reach video snapshot allocation failed");
+    return;
+  }
+  const auto info = SkImageInfo::Make(
+      viewport_pixel_size_.width(), viewport_pixel_size_.height(),
+      kBGRA_8888_SkColorType, kOpaque_SkAlphaType, SkColorSpace::MakeSRGB());
+  if (!surface_->readPixels(info, snapshot_.mapping.memory(), stride, 0, 0)) {
+    Fail("Reach video raster snapshot failed");
+    return;
+  }
+  auto region = snapshot_.region.Duplicate();
+  if (!region.IsValid()) {
+    Fail("Reach video snapshot duplication failed");
+    return;
+  }
+  pending_ = false;
+  in_flight_ = true;
+  sink_->FrameReady(
+      std::move(region), viewport_pixel_size_, stride, generation_, ++sequence_,
+      pending_timestamp_,
+      base::BindOnce(&ReachVideoOutputDevice::Released,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void ReachVideoOutputDevice::Released() {
+  CHECK(in_flight_);
+  in_flight_ = false;
+  DeliverLatest();
+}
+
+void ReachVideoOutputDevice::Fail(const std::string& message) {
+  if (failed_)
+    return;
+  failed_ = true;
+  LOG(ERROR) << message;
+  if (sink_.is_connected())
+    sink_->Error(message);
+}
+
+}  // namespace viz
diff --git components/viz/service/display_embedder/reach_video_output_device.h components/viz/service/display_embedder/reach_video_output_device.h
