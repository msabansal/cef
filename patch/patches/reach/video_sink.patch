@@ -0,0 +1,41 @@
+#ifndef COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_REACH_VIDEO_OUTPUT_DEVICE_H_
+#define COMPONENTS_VIZ_SERVICE_DISPLAY_EMBEDDER_REACH_VIDEO_OUTPUT_DEVICE_H_
+
+#include "base/memory/read_only_shared_memory_region.h"
+#include "base/memory/weak_ptr.h"
+#include "components/viz/service/display/software_output_device.h"
+#include "components/viz/service/viz_service_export.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/viz/privileged/mojom/compositing/display_private.mojom.h"
+
+namespace viz {
+
+// A presentation-free software raster destination. The encoder consumer owns
+// each immutable snapshot until its reply; intervening paints are coalesced.
+class VIZ_SERVICE_EXPORT ReachVideoOutputDevice : public SoftwareOutputDevice {
+ public:
+  explicit ReachVideoOutputDevice(
+      mojo::PendingRemote<mojom::ReachVideoSink> sink);
+  ~ReachVideoOutputDevice() override;
+
+  void Resize(const gfx::Size& size, float scale_factor) override;
+  void EndPaint() override;
+
+ private:
+  void DeliverLatest();
+  void Released();
+  void Fail(const std::string& message);
+
+  mojo::Remote<mojom::ReachVideoSink> sink_;
+  base::MappedReadOnlyRegion snapshot_;
+  uint64_t generation_ = 0;
+  uint64_t sequence_ = 0;
+  bool pending_ = false;
+  base::TimeTicks pending_timestamp_;
+  bool in_flight_ = false;
+  bool failed_ = false;
+  base::WeakPtrFactory<ReachVideoOutputDevice> weak_factory_{this};
+};
+
+}  // namespace viz
+#endif
diff --git components/viz/service/display_embedder/reach_video_output_device_unittest.cc components/viz/service/display_embedder/reach_video_output_device_unittest.cc
new file mode 100644
--- /dev/null
+++ components/viz/service/display_embedder/reach_video_output_device_unittest.cc
@@ -0,0 +1,123 @@
+#include "components/viz/service/display_embedder/reach_video_output_device.h"
+
+#include "base/memory/read_only_shared_memory_region.h"
+#include "base/test/task_environment.h"
+#include "mojo/public/cpp/bindings/receiver.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "third_party/skia/include/core/SkCanvas.h"
+
+namespace viz {
+namespace {
+
+class Consumer : public mojom::ReachVideoSink {
+ public:
+  ~Consumer() override {
+    receiver_.reset();
+    released_.Reset();
+  }
+  void Started(const std::string& stream) override { stream_ = stream; }
+  void FrameReady(base::ReadOnlySharedMemoryRegion pixels,
+                  const gfx::Size& size,
+                  uint32_t stride,
+                  uint64_t generation,
+                  uint64_t sequence,
+                  base::TimeTicks timestamp,
+                  FrameReadyCallback released) override {
+    mapping_ = pixels.Map();
+    size_ = size;
+    stride_ = stride;
+    generation_ = generation;
+    sequence_ = sequence;
+    timestamp_ = timestamp;
+    released_ = std::move(released);
+    ++deliveries_;
+  }
+  void Error(const std::string& message) override { error_ = message; }
+
+  mojo::Receiver<mojom::ReachVideoSink> receiver_{this};
+  base::ReadOnlySharedMemoryMapping mapping_;
+  gfx::Size size_;
+  uint32_t stride_ = 0;
+  uint64_t generation_ = 0;
+  uint64_t sequence_ = 0;
+  base::TimeTicks timestamp_;
+  int deliveries_ = 0;
+  std::string stream_;
+  std::string error_;
+  FrameReadyCallback released_;
+};
+
+TEST(ReachVideoOutputDeviceTest, OwnsPixelsAndCoalescesSlowConsumerToLatest) {
+  base::test::SingleThreadTaskEnvironment tasks(
+      base::test::TaskEnvironment::TimeSource::MOCK_TIME);
+  Consumer consumer;
+  ReachVideoOutputDevice device(consumer.receiver_.BindNewPipeAndPassRemote());
+  device.Resize(gfx::Size(2, 2), 1.0f);
+  device.BeginPaint(gfx::Rect(2, 2))->clear(SK_ColorRED);
+  device.EndPaint();
+  tasks.RunUntilIdle();
+  ASSERT_EQ(consumer.deliveries_, 1);
+  ASSERT_TRUE(consumer.mapping_.IsValid());
+  EXPECT_EQ(static_cast<const uint32_t*>(consumer.mapping_.memory())[0], SK_ColorRED);
+  const auto sequence = consumer.sequence_;
+  device.BeginPaint(gfx::Rect(2, 2))->clear(SK_ColorGREEN);
+  device.EndPaint();
+  device.BeginPaint(gfx::Rect(2, 2))->clear(SK_ColorBLUE);
+  const auto latest_paint = base::TimeTicks::Now();
+  device.EndPaint();
+  tasks.RunUntilIdle();
+  EXPECT_EQ(consumer.deliveries_, 1);
+  EXPECT_EQ(static_cast<const uint32_t*>(consumer.mapping_.memory())[0], SK_ColorRED);
+  tasks.FastForwardBy(base::Seconds(2));
+  consumer.mapping_ = {};
+  std::move(consumer.released_).Run();
+  tasks.RunUntilIdle();
+  ASSERT_EQ(consumer.deliveries_, 2);
+  EXPECT_GT(consumer.sequence_, sequence);
+  EXPECT_EQ(static_cast<const uint32_t*>(consumer.mapping_.memory())[0], SK_ColorBLUE);
+  EXPECT_EQ(consumer.timestamp_, latest_paint);
+}
+
+TEST(ReachVideoOutputDeviceTest, ResizeDoesNotInvalidateAnOutstandingFrame) {
+  base::test::SingleThreadTaskEnvironment tasks;
+  Consumer consumer;
+  ReachVideoOutputDevice device(consumer.receiver_.BindNewPipeAndPassRemote());
+  device.Resize(gfx::Size(2, 2), 1.0f);
+  device.BeginPaint(gfx::Rect(2, 2))->clear(SK_ColorRED);
+  device.EndPaint();
+  tasks.RunUntilIdle();
+  const auto generation = consumer.generation_;
+  device.Resize(gfx::Size(3, 2), 1.0f);
+  device.BeginPaint(gfx::Rect(3, 2))->clear(SK_ColorGREEN);
+  device.EndPaint();
+  tasks.RunUntilIdle();
+  EXPECT_EQ(consumer.size_, gfx::Size(2, 2));
+  EXPECT_EQ(static_cast<const uint32_t*>(consumer.mapping_.memory())[0], SK_ColorRED);
+  consumer.mapping_ = {};
+  std::move(consumer.released_).Run();
+  tasks.RunUntilIdle();
+  EXPECT_EQ(consumer.size_, gfx::Size(3, 2));
+  EXPECT_EQ(consumer.stride_, 12u);
+  EXPECT_GT(consumer.generation_, generation);
+  EXPECT_EQ(static_cast<const uint32_t*>(consumer.mapping_.memory())[0], SK_ColorGREEN);
+}
+
+TEST(ReachVideoOutputDeviceTest, SnapshotAndLateReplySurviveProducerTeardown) {
+  base::test::SingleThreadTaskEnvironment tasks;
+  Consumer consumer;
+  auto device = std::make_unique<ReachVideoOutputDevice>(
+      consumer.receiver_.BindNewPipeAndPassRemote());
+  device->Resize(gfx::Size(2, 2), 1.0f);
+  device->BeginPaint(gfx::Rect(2, 2))->clear(SK_ColorRED);
+  device->EndPaint();
+  tasks.RunUntilIdle();
+  ASSERT_EQ(consumer.deliveries_, 1);
+  device.reset();
+  EXPECT_EQ(static_cast<const uint32_t*>(consumer.mapping_.memory())[0], SK_ColorRED);
+  std::move(consumer.released_).Run();
+  tasks.RunUntilIdle();
+  EXPECT_EQ(consumer.deliveries_, 1);
+}
+
+}  // namespace
+}  // namespace viz
