+// Producer-side stage times on the same monotonic clock as |timestamp|.
+struct ReachVideoFrameTiming {
+  // EndPaint of the earliest damage coalesced into this frame.
+  mojo_base.mojom.TimeTicks first_paint;
+  mojo_base.mojom.TimeTicks read_start;
+  mojo_base.mojom.TimeTicks read_end;
+  mojo_base.mojom.TimeTicks sent;
+};
+
+// Each frame leases one producer-owned snapshot slot. The reply releases
+// exactly that slot; the producer never overwrites a leased slot. Consumers
+// reply once the snapshot has been consumed downstream, so the number of
+// outstanding replies is the real pipeline depth. The producer throttles as
+// it grows and stops, coalescing the latest damage, when every slot is leased.
+interface ReachVideoSink {
+  Started(string stream);
+  // |damage| is the union of damage since the previous delivered frame, or
+  // the whole frame after a generation change. |outstanding| includes this
+  // frame.
+  FrameReady(uint32 slot, mojo_base.mojom.ReadOnlySharedMemoryRegion pixels,
+             gfx.mojom.Size size, uint32 stride, uint64 generation,
+             uint64 sequence, mojo_base.mojom.TimeTicks timestamp,
+             gfx.mojom.Rect damage, uint32 outstanding,
+             ReachVideoFrameTiming timing) => ();
+  Error(string message);
+};
