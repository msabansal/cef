++      }
++    }
++    auto victim = std::find_if(
++        entries_.begin(), entries_.end(), [&](const Entry& entry) {
++          if (entry.kind != Kind::kAppend) {
++            return false;
++          }
++          const auto init = latest_init.find(entry.buffer);
++          return init == latest_init.end() || init->second != entry.seq;
++        });
++    if (victim == entries_.end()) {
++      if (bytes_ > kMaxJournalBytes || entries_.size() > kMaxEntries) {
