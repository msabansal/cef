+void HTMLMediaElement::EnableReachReplay() {
+  if (!reach_replay_token_.is_empty())
+    return;
+  reach_replay_token_ = base::UnguessableToken::Create();
+  reach_replay_ready_ = false;
+  UpdateReachReplayState();
+}
+
+void HTMLMediaElement::DisableReachReplay() {
+  if (reach_replay_token_.is_empty())
+    return;
+  reach_replay_token_ = base::UnguessableToken();
+  reach_replay_ready_ = false;
+  UpdateReachReplayState();
+}
+
+bool HTMLMediaElement::SetReachReplayReady(const std::string& token,
+                                           bool ready) {
+  if (reach_replay_token_.is_empty() || token != reach_replay_token_.ToString())
+    return false;
+  if (reach_replay_ready_ != ready) {
+    reach_replay_ready_ = ready;
+    UpdateReachReplayState();
+  }
+  return true;
+}
+
+void HTMLMediaElement::UpdateReachReplayState() {
+  base::AutoReset<bool> updating(&reach_replay_updating_, true);
+  SetReadyState(reach_source_ready_state_);
+  UpdatePlayState();
+}
