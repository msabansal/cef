+    cc::PaintCanvasAutoRestore restore(context.Canvas(), true);
+    context.Canvas()->translate(rect.X().ToFloat(), rect.Y().ToFloat());
+    context.Canvas()->clipRect(
+        SkRect::MakeWH(rect.Width().ToFloat(), rect.Height().ToFloat()));
+    context.Canvas()->scale(rect.Width().ToFloat(), rect.Height().ToFloat());
+    context.Canvas()->recordCustomData(
+        layout_embedded_content_.GetNode()->GetDomNodeId());
+    return;
+  }
