+      return "WebGL absolute sequence exhausted";
+    // Include node/string storage; never charge only a context's payload.
+    if (original_hash.capacity() > kLimit / 2 || delivery_bytes > kLimit)
+      return "Combined WebGL pending delivery budget exceeded";
+    const size_t overhead =
+        sizeof(Entry) + 2 * sizeof(void*) + 2 + original_hash.capacity();
+    if (command.capacity() > kLimit - overhead)
+      return "Combined WebGL pending delivery budget exceeded";
+    const size_t charge = command.capacity() + overhead;
+    Reservation own;
+    Reservation* held = reservation ? reservation : &own;
+    if (!held->Reserve(aggregate_, charge))
