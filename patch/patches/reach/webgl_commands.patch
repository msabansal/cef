+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_REACH_WEBGL_JOURNAL_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_REACH_WEBGL_JOURNAL_H_
+
+#include <cmath>
+#include <cstdint>
+#include <functional>
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <type_traits>
+#include <utility>
+#include <vector>
+
+#include "base/containers/span.h"
+#include "base/values.h"
+#include "third_party/blink/renderer/core/typed_arrays/dom_array_buffer.h"
+#include "third_party/blink/renderer/core/typed_arrays/dom_array_buffer_view.h"
+#include "third_party/blink/renderer/modules/modules_export.h"
+#include "third_party/blink/renderer/modules/webgl/reach_webgl_pending.h"
+#include "third_party/blink/renderer/modules/webgl/webgl_extension.h"
+#include "third_party/blink/renderer/modules/webgl/webgl_object.h"
+#include "third_party/blink/renderer/modules/webgl/webgl_uniform_location.h"
+#include "third_party/blink/renderer/platform/bindings/exception_state.h"
+#include "third_party/blink/renderer/platform/graphics/reach_image_bitmap_original.h"
+#include "third_party/blink/renderer/platform/heap/persistent.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+#include "third_party/skia/include/core/SkData.h"
+
+namespace v8 {
+class Isolate;
+}
+
+namespace blink {
+
+class Document;
+class HTMLCanvasElement;
+class ScriptState;
+class WebGLProgram;
+class WebGLRenderingContextBase;
+
+struct ReachWebGLCommand {
+  base::DictValue value;
+  std::string error;
+  size_t input_bytes = 0;
+  ReachWebGLPending::Reservation reservation;
+  ReachWebGLPending::Reservation original_reservation;
+  bool texture_source = false;
+  std::string original_hash;
+  sk_sp<const SkData> original;
+  bool original_precharged = false;
+  std::optional<ReachImageBitmapOriginal::Unpack> unpack_before;
+  std::optional<ReachImageBitmapOriginal::Unpack> unpack_after;
+};
+
+class MODULES_EXPORT ReachWebGLJournal final {
+ public:
+  class CommandScope {
+   public:
+    CommandScope(ReachWebGLJournal* journal, ReachWebGLCommand* command)
+        : journal_(journal),
+          previous_(journal ? std::exchange(journal->pending_, command)
+                            : nullptr) {}
+    CommandScope(const CommandScope&) = delete;
+    CommandScope& operator=(const CommandScope&) = delete;
+    ~CommandScope() {
+      if (journal_)
+        journal_->pending_ = previous_;
+    }
+
+   private:
+    ReachWebGLJournal* journal_;
+    ReachWebGLCommand* previous_;
+  };
+
+  explicit ReachWebGLJournal(WebGLRenderingContextBase&);
+  static constexpr size_t kMaxOriginalBytes = ReachWebGLPending::kLimit - 256;
+  ~ReachWebGLJournal();
+
+  static ReachWebGLJournal* Find(uint64_t);
+  static std::vector<ReachWebGLJournal*> Current();
+  static void SetChangeCallback(void (*callback)(HTMLCanvasElement*));
+  // The factory runs while the canvas is live; its result must be GC-safe.
+  static void SetRetirementCallback(
+      std::function<void()> (*callback)(HTMLCanvasElement*));
+  static void SetOriginalHasher(
+      std::string (*hasher)(base::span<const uint8_t>));
+  static bool ShouldRecord(std::string_view);
+  static std::atomic_size_t& Budget();
+  bool usable() const { return error_.empty(); }
+  const std::string& error() const { return error_; }
+  uint64_t generation() const { return generation_; }
+  uint64_t retired() const { return commands_.retired(); }
+  void ClearChangeNotification();
+  HTMLCanvasElement* element() const;
+  std::string State();
+  std::string Read(uint64_t cursor,
+                   size_t max_bytes,
+                   std::vector<uint8_t>* output,
+                   std::map<std::string, std::vector<uint8_t>>* originals);
+  std::string Applied(uint64_t generation, uint64_t through);
+  std::string ReadSlice(uint64_t cursor,
+                        size_t offset,
+                        size_t max_bytes,
+                        bool original,
+                        std::vector<uint8_t>* output,
+                        std::map<std::string, std::vector<uint8_t>>* data);
+  std::string Sent(uint64_t generation, uint64_t through) {
+    return usable() ? commands_.Sent(generation, through)
+                    : "WebGL sent stream is unavailable";
+  }
+  void Append(ReachWebGLCommand);
+  void Resize(int width, int height);
+  void Discard();
+  void Extension(const String&, WebGLExtension*);
+  void Program(ReachWebGLCommand&, WebGLProgram*);
+  void Result(ReachWebGLCommand&, const ScriptWrappable*);
+  void Result(ReachWebGLCommand&, uint32_t);
+  void Target(ReachWebGLCommand&, WebGLExtension*);
+  bool HasTextureSource() const {
+    return pending_ && pending_->texture_source;
+  }
+  void TextureUpload(base::ListValue, unsigned, base::span<const uint8_t>);
+  void RejectTextureUpload(std::string_view);
+  void OriginalTexture(base::ListValue,
+                       sk_sp<const SkData>,
+                       int width,
+                       int height);
+  bool ReserveOriginalBytes(size_t);
+  void OriginalImageBitmapTexture(
+      base::ListValue,
+      std::shared_ptr<const ReachImageBitmapOriginal>,
+      int width,
+      int height,
+      ReachImageBitmapOriginal::Unpack restore);
+
+  template <typename T>
+  void Argument(ReachWebGLCommand& command,
+                base::ListValue& args,
+                const T& value) {
+    using V = std::remove_cvref_t<T>;
+    if constexpr (std::is_same_v<V, ExceptionState> ||
+                  std::is_same_v<V, v8::Isolate*> ||
+                  std::is_same_v<V, ScriptState*>) {
+      return;
+    } else {
+      args.Append(Encode(command, value));
+    }
+  }
+
+ private:
+  struct Identity {
+    WeakPersistent<const ScriptWrappable> object;
+    uint32_t id;
+  };
+  struct Original {
+    sk_sp<const SkData> data;
+    uint64_t last_next;
+    size_t charge;
+  };
+
+  base::Value Bytes(ReachWebGLCommand&,
+                    std::string_view,
+                    base::span<const uint8_t>);
+  base::Value View(ReachWebGLCommand&, const DOMArrayBufferView&);
+  base::Value Reference(ReachWebGLCommand&, const ScriptWrappable*);
+  uint32_t CreateIdentity(ReachWebGLCommand&, const ScriptWrappable*);
+  void Collect();
+  void Fail(std::string_view);
+  void NotifyChange();
+  void RefreshRetirementNotification();
+
+  template <typename T>
+  base::Value Encode(ReachWebGLCommand& command, const T& value) {
+    using V = std::remove_cvref_t<T>;
+    if (!command.error.empty())
+      return base::Value();
+    if constexpr (std::is_same_v<V, bool>) {
+      return base::Value(value);
+    } else if constexpr (std::is_arithmetic_v<V> || std::is_enum_v<V>) {
+      const double number = static_cast<double>(value);
+      if (!std::isfinite(number) || std::abs(number) > 9007199254740991.0) {
+        command.error = "Nonrepresentable WebGL argument";
+        return base::Value();
+      }
+      return base::Value(number);
+    } else if constexpr (std::is_convertible_v<const V&, String>) {
+      const String text = static_cast<String>(value);
+      const size_t encoded = ReachWebGLPending::JSONStringBound(text);
+      if (encoded > ReachWebGLPending::kLimit - command.input_bytes ||
+          !command.reservation.Grow(Budget(), encoded + 128)) {
+        command.error = "WebGL string budget exceeded";
+        return base::Value();
+      }
+      command.input_bytes += encoded;
+      return base::Value(text.Utf8());
+    } else if constexpr (std::is_pointer_v<V>) {
+      using Element = std::remove_cv_t<std::remove_pointer_t<V>>;
+      if (!value)
+        return base::Value();
+      if constexpr (std::is_convertible_v<V, const DOMArrayBufferView*>) {
+        return View(command, *value);
+      } else if constexpr (std::is_convertible_v<V,
+                                                 const DOMArrayBufferBase*>) {
+        return Bytes(command, "ArrayBuffer", value->ByteSpanMaybeShared());
+      } else if constexpr (std::is_convertible_v<V, const WebGLObject*> ||
+                           std::is_same_v<Element, WebGLUniformLocation> ||
+                           std::is_convertible_v<V, const WebGLExtension*>) {
+        return Reference(command, value);
+      }
+      command.texture_source = true;
+      command.error = "WebGL source argument requires command transport";
+      return base::Value();
+    } else if constexpr (requires { value.Get(); }) {
+      return Encode(command, value.Get());
+    } else if constexpr (requires { value.as_span(); }) {
+      return Encode(command, value.as_span());
+    } else if constexpr (requires {
+                           value.has_value();
+                           *value;
+                         }) {
+      return value.has_value() ? Encode(command, *value) : base::Value();
+    } else if constexpr (requires {
+                           typename V::value_type;
+                           value.data();
+                           value.size();
+                         }) {
+      using Element = std::remove_cv_t<typename V::value_type>;
+      if constexpr (std::is_arithmetic_v<Element>) {
+        std::string_view type;
+        if constexpr (std::is_same_v<Element, float>)
+          type = "Float32Array";
+        else if constexpr (std::is_same_v<Element, double>)
+          type = "Float64Array";
+        else if constexpr (sizeof(Element) == 4)
+          type = std::is_signed_v<Element> ? "Int32Array" : "Uint32Array";
+        else if constexpr (sizeof(Element) == 2)
+          type = std::is_signed_v<Element> ? "Int16Array" : "Uint16Array";
+        else if constexpr (sizeof(Element) == 1)
+          type = std::is_signed_v<Element> ? "Int8Array" : "Uint8Array";
+        if (!type.empty()) {
+          if constexpr (std::has_unique_object_representations_v<Element>)
+            return Bytes(command, type, base::as_byte_span(value));
+          else
+            return Bytes(command, type,
+                         base::as_byte_span(base::allow_nonunique_obj, value));
+        }
+      }
+      return Sequence(command, value);
+    } else if constexpr (requires {
+                           value.begin();
+                           value.end();
+                           value.size();
+                         }) {
+      return Sequence(command, value);
+    } else {
+      command.error = "Unsupported converted WebGL argument";
+      return base::Value();
+    }
+  }
+
+  template <typename T>
+  base::Value Sequence(ReachWebGLCommand& command, const T& values) {
+    if (values.size() >
+            (ReachWebGLPending::kLimit - command.input_bytes) / 128 ||
+        !command.reservation.Grow(Budget(), values.size() * 128)) {
+      command.error = "WebGL argument list budget exceeded";
+      return base::Value();
+    }
+    command.input_bytes += values.size() * 128;
+    base::ListValue result;
+    for (const auto& value : values)
+      result.Append(Encode(command, value));
+    return base::Value(std::move(result));
+  }
+
+  WeakPersistent<WebGLRenderingContextBase> context_;
+  WeakPersistent<HTMLCanvasElement> element_;
+  const uint64_t id_;
+  const uint64_t generation_;
+  std::map<const ScriptWrappable*, Identity> identities_;
+  uint32_t next_identity_ = 1;
+  ReachWebGLPending commands_;
+  std::map<std::string, Original> originals_;
+  size_t original_bytes_ = 0;
+  std::string error_;
+  ReachWebGLCommand* pending_ = nullptr;
+  bool change_pending_ = false;
+  WeakPersistent<Document> retirement_document_;
+  std::function<void()> retirement_notification_;
+};
+
+}  // namespace blink
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_REACH_WEBGL_JOURNAL_H_
diff --git third_party/blink/renderer/modules/webgl/reach_webgl_pending.h third_party/blink/renderer/modules/webgl/reach_webgl_pending.h
new file mode 100644
index 0000000..6d4db0f
--- /dev/null
+++ third_party/blink/renderer/modules/webgl/reach_webgl_pending.h
@@ -0,0 +1,258 @@
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_REACH_WEBGL_PENDING_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_REACH_WEBGL_PENDING_H_
+
+#include <algorithm>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <iterator>
+#include <limits>
+#include <list>
+#include <string>
+#include <utility>
+
+namespace blink {
+
+// Delivery state only. This is deliberately not a reconstruction checkpoint.
+class ReachWebGLPending final {
+ public:
+  static constexpr size_t kLimit = 256 * 1024 * 1024;
+  static constexpr size_t kMaxSlice = 96 * 1024;
+  struct Slice {
+    size_t total = 0;
+    size_t length = 0;
+    std::string original_hash;
+    size_t original_bytes = 0;
+  };
+  class Reservation {
+   public:
+    Reservation() = default;
+    Reservation(const Reservation&) = delete;
+    Reservation& operator=(const Reservation&) = delete;
+    Reservation(Reservation&& other) noexcept { *this = std::move(other); }
+    Reservation& operator=(Reservation&& other) noexcept {
+      if (this != &other) {
+        Reset();
+        aggregate_ = std::exchange(other.aggregate_, nullptr);
+        bytes_ = std::exchange(other.bytes_, 0);
+      }
+      return *this;
+    }
+    ~Reservation() { Reset(); }
+    bool Reserve(std::atomic_size_t& aggregate, size_t bytes) {
+      if (bytes > kLimit || (aggregate_ && aggregate_ != &aggregate))
+        return false;
