+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_REACH_IMAGE_BITMAP_ORIGINAL_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_REACH_IMAGE_BITMAP_ORIGINAL_H_
+
+#include <array>
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <utility>
+#include <vector>
+
+namespace blink {
+
+// Immutable current-source ownership, not a delivered-command archive.
+class ReachImageBitmapOriginal final {
+ public:
+  static constexpr size_t kLimit = 256 * 1024 * 1024;
+  static constexpr size_t kMaxBytes = kLimit - 256;
+  using Unpack = std::array<int, 3>;
+
+  static std::shared_ptr<const ReachImageBitmapOriginal> Create(
+      std::atomic_size_t& budget,
+      std::vector<uint8_t> bytes,
+      Unpack unpack) {
+    const size_t size = bytes.size();
+    return CreateCopied(budget, size, unpack,
+                        [&bytes] { return std::move(bytes); });
+  }
+
+  // Reserve ownership before copying browser-owned encoded data.
+  template <typename Copy>
+  static std::shared_ptr<const ReachImageBitmapOriginal> CreateCopied(
+      std::atomic_size_t& budget,
+      size_t size,
+      Unpack unpack,
+      Copy copy) {
+    if (!size || size > kMaxBytes || (unpack[0] != 0 && unpack[0] != 1) ||
+        (unpack[1] != 0 && unpack[1] != 1) ||
+        (unpack[2] != 0 && unpack[2] != 37444)) {
+      return nullptr;
+    }
+    const size_t charge = size + 256;
+    size_t previous = budget.load(std::memory_order_relaxed);
+    do {
+      if (previous > kLimit - charge)
+        return nullptr;
+    } while (!budget.compare_exchange_weak(previous, previous + charge,
+                                           std::memory_order_relaxed));
+    struct Release {
+      std::atomic_size_t& budget;
+      size_t charge;
+      ~Release() { budget.fetch_sub(charge, std::memory_order_relaxed); }
+    } release{budget, charge};
+    auto bytes = copy();
+    if (bytes.size() != size || bytes.capacity() > kMaxBytes)
+      return nullptr;
+    const size_t extra = bytes.capacity() - size;
+    previous = budget.load(std::memory_order_relaxed);
+    do {
+      if (previous > kLimit - extra)
+        return nullptr;
+    } while (!budget.compare_exchange_weak(previous, previous + extra,
+                                           std::memory_order_relaxed));
+    release.charge += extra;
+    auto* original = new ReachImageBitmapOriginal(budget, std::move(bytes),
+                                                  unpack, release.charge);
+    release.charge = 0;
+    return std::shared_ptr<const ReachImageBitmapOriginal>(original);
+  }
+
+  ReachImageBitmapOriginal(const ReachImageBitmapOriginal&) = delete;
+  ReachImageBitmapOriginal& operator=(const ReachImageBitmapOriginal&) = delete;
+  ~ReachImageBitmapOriginal() {
+    budget_.fetch_sub(charge_, std::memory_order_relaxed);
+  }
+  const std::vector<uint8_t>& bytes() const { return bytes_; }
+  const Unpack& unpack() const { return unpack_; }
+
+ private:
+  ReachImageBitmapOriginal(std::atomic_size_t& budget,
+                           std::vector<uint8_t> bytes,
+                           Unpack unpack,
+                           size_t charge)
+      : budget_(budget),
+        bytes_(std::move(bytes)),
+        unpack_(unpack),
+        charge_(charge) {}
+
+  std::atomic_size_t& budget_;
+  const std::vector<uint8_t> bytes_;
+  const Unpack unpack_;
+  const size_t charge_;
+};
+
+}  // namespace blink
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_GRAPHICS_REACH_IMAGE_BITMAP_ORIGINAL_H_
