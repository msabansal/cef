+    std::advance(it, cursor - retired_);
+    slice->total = original ? it->delivery_bytes : it->value.size();
+    slice->original_hash = it->original_hash;
+    slice->original_bytes = it->delivery_bytes;
+    if (offset >= slice->total || (original && it->original_hash.empty()))
+      return "WebGL slice offset or original membership is invalid";
+    if (cursor == read_through_ && slice_cursor_ != cursor) {
+      slice_cursor_ = cursor;
