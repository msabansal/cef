+  // Count escaped UTF-16 before allocating the UTF-8/JSON representation.
+  template <typename Text>
+  static size_t JSONStringBound(const Text& value) {
+    size_t size = 2;
+    for (decltype(value.length()) i = 0; i < value.length(); ++i) {
+      const uint32_t c = value[i];
+      size_t add = c <= 0x7f ? 1 : c <= 0x7ff ? 2 : 3;
+      if (c == '"' || c == '\\' || c == '\n' || c == '\r' || c == '\t' ||
+          c == '\b' || c == '\f')
+        add = 2;
+      else if (c < 32 || c == '<' || c == 0x2028 || c == 0x2029)
+        add = 6;
+      else if (c >= 0xd800 && c <= 0xdbff && value.length() - i >= 2 &&
+               value[i + 1] >= 0xdc00 && value[i + 1] <= 0xdfff) {
+        add = 4;
+        ++i;
+      } else if (c >= 0xd800 && c <= 0xdfff) {
