+        const size_t extra = bytes - bytes_;
+        size_t previous = aggregate.load();
+        do {
+          if (previous > kLimit - extra)
+            return false;
+        } while (!aggregate.compare_exchange_weak(previous, previous + extra));
+      } else {
+        aggregate.fetch_sub(bytes_ - bytes);
+      }
+      aggregate_ = &aggregate;
+      bytes_ = bytes;
+      return true;
+    }
+    bool Grow(std::atomic_size_t& aggregate, size_t bytes) {
+      return bytes <= kLimit - bytes_ && Reserve(aggregate, bytes_ + bytes);
+    }
+    void Transfer() {
+      aggregate_ = nullptr;
+      bytes_ = 0;
+    }
+
+   private:
+    void Reset() {
+      if (aggregate_)
