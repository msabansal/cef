+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_REACH_WEBGL_CALL_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_REACH_WEBGL_CALL_H_
+
+#include <functional>
+#include <type_traits>
+#include <utility>
+
+#include "third_party/blink/renderer/modules/webgl/reach_webgl_journal.h"
+#include "third_party/blink/renderer/modules/webgl/webgl_program.h"
+#include "third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.h"
+#include "third_party/blink/renderer/platform/graphics/canvas_2d_bitmap_provider.h"
+
+namespace blink {
+
+template <typename T>
+bool ReachIsReadbackView(const T& value) {
+  using V = std::remove_cvref_t<T>;
+  if constexpr (std::is_convertible_v<V, const DOMArrayBufferView*>)
+    return true;
+  else if constexpr (requires { value.Get(); })
+    return ReachIsReadbackView(value.Get());
+  return false;
+}
+
+template <typename Receiver, typename F, typename... Args>
+std::invoke_result_t<F, Args...> ReachInvokeWebGL(Receiver* receiver,
+                                                  const char* name,
+                                                  F&& invoke,
+                                                  Args&&... args) {
+  using Result = std::invoke_result_t<F, Args...>;
+  WebGLRenderingContextBase* context = nullptr;
+  if constexpr (std::is_base_of_v<WebGLRenderingContextBase, Receiver>) {
+    context = receiver;
+  } else {
+    context = WebGLExtensionScopedContext(receiver).Context();
+  }
+  ReachWebGLJournal* journal = nullptr;
+  const bool cpu_readback = std::string_view(name) == "readPixels" &&
+                            (ReachIsReadbackView(args) || ...);
+  if (Canvas2DBitmapProvider::IsReachWebGLCommandMode() && context &&
+      !context->isContextLost() && !cpu_readback &&
+      ReachWebGLJournal::ShouldRecord(name)) {
+    journal = context->ReachJournal();
+  }
+  const uint64_t serial = context ? context->ReachValidationSerial() : 0;
+  ReachWebGLCommand command;
+  if (journal && journal->usable()) {
+    command.value.Set("op", name);
+    base::ListValue encoded;
+    (journal->Argument(command, encoded, args), ...);
+    if (!command.error.empty())
+      command.error = std::string(name) + ": " + command.error;
+    command.value.Set("args", std::move(encoded));
+    if constexpr (std::is_base_of_v<WebGLExtension, Receiver>)
+      journal->Target(command, receiver);
+  } else {
+    journal = nullptr;
+  }
+  ReachWebGLJournal::CommandScope command_scope(journal, &command);
+  const auto accepted = [&] {
+    if (!journal || context->isContextLost() ||
+        context->ReachValidationSerial() != serial) {
+      return false;
+    }
+    bool exception = false;
+    const auto check = [&]<typename T>(const T& value) {
+      if constexpr (std::is_same_v<std::remove_cvref_t<T>, ExceptionState>)
+        exception |= value.HadException();
+    };
+    (check(args), ...);
+    return !exception;
+  };
+  const auto commit = [&] {
+    const auto decorate = [&]<typename T>(const T& value) {
+      if constexpr (std::is_convertible_v<T, WebGLProgram*>) {
+        if (std::string_view(name) == "linkProgram")
+          journal->Program(command, value);
+      }
+    };
+    (decorate(args), ...);
+    journal->Append(std::move(command));
+  };
+  if constexpr (std::is_void_v<Result>) {
+    std::invoke(std::forward<F>(invoke), std::forward<Args>(args)...);
+    if (accepted())
+      commit();
+  } else {
+    Result result =
+        std::invoke(std::forward<F>(invoke), std::forward<Args>(args)...);
+    if (accepted()) {
+      if constexpr (std::is_pointer_v<Result> &&
+                    std::is_convertible_v<Result, const ScriptWrappable*>) {
+        journal->Result(command, result);
+      } else if constexpr (std::is_integral_v<Result>) {
+        if (std::string_view(name) == "getUniformBlockIndex")
+          journal->Result(command, static_cast<uint32_t>(result));
+      }
+      commit();
+    }
+    return result;
+  }
+}
+
+}  // namespace blink
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_REACH_WEBGL_CALL_H_
diff --git third_party/blink/renderer/modules/webgl/reach_webgl_journal.cc third_party/blink/renderer/modules/webgl/reach_webgl_journal.cc
new file mode 100644
index 0000000..9df53ca
--- /dev/null
+++ third_party/blink/renderer/modules/webgl/reach_webgl_journal.cc
@@ -0,0 +1,764 @@
+#include "third_party/blink/renderer/modules/webgl/reach_webgl_journal.h"
+
+#include <algorithm>
+#include <atomic>
+
+#include "base/base64.h"
+#include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/rand_util.h"
+#include "base/strings/string_number_conversions.h"
+#include "gpu/command_buffer/client/gles2_interface.h"
+#include "third_party/blink/renderer/bindings/modules/v8/v8_webgl_context_attributes.h"
+#include "third_party/blink/renderer/core/html/canvas/html_canvas_element.h"
+#include "third_party/blink/renderer/modules/webgl/webgl_program.h"
+#include "third_party/blink/renderer/modules/webgl/webgl_rendering_context_base.h"
+#include "third_party/blink/renderer/platform/graphics/canvas_2d_bitmap_provider.h"
+
+namespace blink {
+namespace {
+
+constexpr uint64_t kJournalBit = uint64_t{1} << 63;
+constexpr size_t kMaxCommandBytes = ReachWebGLPending::kLimit;
+constexpr uint32_t kMaxObjects = 65536;
+static_assert(ReachWebGLPending::kLimit == ReachImageBitmapOriginal::kLimit);
+
+using Journals = std::map<uint64_t, WeakPersistent<WebGLRenderingContextBase>>;
+
+Journals& Registry() {
+  static base::NoDestructor<Journals> journals;
+  return *journals;
+}
+
+std::atomic_size_t& RetainedBytes() {
+  return Canvas2DBitmapProvider::ReachWebGLPendingBytes();
+}
+
+void (*change_callback)(HTMLCanvasElement*) = nullptr;
+std::function<void()> (*retirement_callback)(HTMLCanvasElement*) = nullptr;
+std::string (*original_hasher)(base::span<const uint8_t>) = nullptr;
+
+uint64_t NextId() {
+  uint64_t id;
+  do {
+    id = kJournalBit | base::RandUint64();
+  } while (Registry().contains(id));
+  return id;
+}
+
+}  // namespace
+
+std::atomic_size_t& ReachWebGLJournal::Budget() {
+  return RetainedBytes();
+}
+
+ReachWebGLJournal::ReachWebGLJournal(WebGLRenderingContextBase& context)
+    : context_(&context),
+      element_(context.Host() && !context.Host()->IsOffscreenCanvas()
+                   ? static_cast<HTMLCanvasElement*>(context.Host())
+                   : nullptr),
+      id_(NextId()),
+      generation_(context.GetContextGeneration()),
+      commands_(RetainedBytes(), generation_) {
+  auto& journals = Registry();
+  for (auto it = journals.begin(); it != journals.end();) {
+    auto* owner = it->second.Get();
+    auto* journal = owner ? owner->ReachExistingJournal() : nullptr;
+    if (!journal || journal->id_ != it->first ||
+        journal->generation_ != owner->GetContextGeneration())
+      it = journals.erase(it);
+    else
+      ++it;
+  }
+  if (!element_ || journals.size() >= 64) {
+    Fail("WebGL context ownership or context budget is invalid");
+    return;
+  }
+  RefreshRetirementNotification();
+  journals.emplace(id_, WeakPersistent<WebGLRenderingContextBase>(&context));
+  Resize(context.drawingBufferWidth(), context.drawingBufferHeight());
+  for (const char* name : {"viewport", "scissor"}) {
+    ReachWebGLCommand command;
+    command.value.Set("op", name);
+    base::ListValue args;
+    args.Append(0);
+    args.Append(0);
+    args.Append(context.drawingBufferWidth());
+    args.Append(context.drawingBufferHeight());
+    command.value.Set("args", std::move(args));
+    Append(std::move(command));
+  }
+}
+
+ReachWebGLJournal::~ReachWebGLJournal() {
+  RetainedBytes().fetch_sub(original_bytes_, std::memory_order_relaxed);
+  if (retirement_notification_)
+    retirement_notification_();
+}
+
+HTMLCanvasElement* ReachWebGLJournal::element() const {
+  return element_.Get();
+}
+
+ReachWebGLJournal* ReachWebGLJournal::Find(uint64_t id) {
+  auto it = Registry().find(id);
+  auto* context = it == Registry().end() ? nullptr : it->second.Get();
+  auto* journal = context ? context->ReachExistingJournal() : nullptr;
+  return journal && journal->id_ == id &&
+                 journal->generation_ == context->GetContextGeneration()
+             ? journal
+             : nullptr;
+}
+
+std::vector<ReachWebGLJournal*> ReachWebGLJournal::Current() {
+  std::vector<ReachWebGLJournal*> result;
+  for (const auto& [id, owner] : Registry()) {
+    if (auto* journal = Find(id))
+      result.push_back(journal);
+  }
+  return result;
+}
+
+void ReachWebGLJournal::SetChangeCallback(
+    void (*callback)(HTMLCanvasElement*)) {
+  change_callback = callback;
+}
+
+void ReachWebGLJournal::SetRetirementCallback(
+    std::function<void()> (*callback)(HTMLCanvasElement*)) {
+  retirement_callback = callback;
+}
+
+void ReachWebGLJournal::RefreshRetirementNotification() {
+  auto* document = element_ ? &element_->GetDocument() : nullptr;
+  if (!document || !retirement_callback || retirement_document_ == document)
+    return;
+  // Binding may allocate a document supplement during weak-registry discovery.
+  Persistent<WebGLRenderingContextBase> retained_context = context_.Get();
+  Persistent<HTMLCanvasElement> retained_element = element_.Get();
+  Persistent<Document> retained_document = document;
+  // Adoption also invalidates the previously authoritative owner's inventory.
+  if (retirement_notification_)
+    retirement_notification_();
+  retirement_document_ = retained_document.Get();
+  retirement_notification_ = retirement_callback(retained_element.Get());
+}
+
+void ReachWebGLJournal::ClearChangeNotification() {
+  change_pending_ = false;
+  RefreshRetirementNotification();
+}
+
+void ReachWebGLJournal::SetOriginalHasher(
+    std::string (*hasher)(base::span<const uint8_t>)) {
+  original_hasher = hasher;
+}
+
+bool ReachWebGLJournal::ShouldRecord(std::string_view name) {
+  if (name == "getUniformLocation" || name == "getUniformBlockIndex")
+    return true;
+  return !name.starts_with("get") && !name.starts_with("is") &&
+         name != "checkFramebufferStatus" && name != "makeXRCompatible";
+}
+
+void ReachWebGLJournal::Fail(std::string_view error) {
+  if (error_.empty())
+    error_ = error;
+  NotifyChange();
+}
+
+void ReachWebGLJournal::NotifyChange() {
+  RefreshRetirementNotification();
+  if (change_callback && element_ && !change_pending_) {
+    change_pending_ = true;
+    change_callback(element_.Get());
+  }
+}
+
+base::Value ReachWebGLJournal::Bytes(ReachWebGLCommand& command,
+                                     std::string_view type,
+                                     base::span<const uint8_t> bytes) {
+  const size_t available = kMaxCommandBytes - command.input_bytes;
+  // Base64 is the retained representation. Bound expansion before allocating,
+  // not by an unrelated raw-upload or IPC-sized individual-command limit.
+  if (bytes.size() > (available / 4) * 3) {
+    command.error = "WebGL copied upload budget exceeded";
+    return base::Value();
+  }
+  command.input_bytes += ((bytes.size() + 2) / 3) * 4;
+  if (!command.reservation.Grow(RetainedBytes(),
+                                ((bytes.size() + 2) / 3) * 4 + 128)) {
+    command.error = "Combined WebGL pending upload budget exceeded";
+    return base::Value();
+  }
+  base::DictValue upload;
+  upload.Set("type", type);
+  upload.Set("data", base::Base64Encode(bytes));
+  return base::Value(std::move(upload));
+}
+
+base::Value ReachWebGLJournal::View(ReachWebGLCommand& command,
+                                    const DOMArrayBufferView& view) {
+  std::string_view type;
+  switch (view.GetType()) {
+    case DOMArrayBufferView::kTypeInt8:
+      type = "Int8Array";
+      break;
+    case DOMArrayBufferView::kTypeUint8:
+      type = "Uint8Array";
+      break;
+    case DOMArrayBufferView::kTypeUint8Clamped:
+      type = "Uint8ClampedArray";
+      break;
+    case DOMArrayBufferView::kTypeInt16:
+      type = "Int16Array";
+      break;
+    case DOMArrayBufferView::kTypeUint16:
+      type = "Uint16Array";
+      break;
+    case DOMArrayBufferView::kTypeInt32:
+      type = "Int32Array";
+      break;
+    case DOMArrayBufferView::kTypeUint32:
+      type = "Uint32Array";
+      break;
+    case DOMArrayBufferView::kTypeFloat32:
+      type = "Float32Array";
+      break;
+    case DOMArrayBufferView::kTypeFloat64:
+      type = "Float64Array";
+      break;
+    default:
+      command.error = "Unsupported WebGL upload view";
+      return base::Value();
+  }
+  return Bytes(command, type, view.ByteSpanMaybeShared());
+}
+
+void ReachWebGLJournal::RejectTextureUpload(std::string_view error) {
+  if (HasTextureSource())
+    pending_->error = error;
+}
+
+void ReachWebGLJournal::OriginalImageBitmapTexture(
+    base::ListValue args,
+    std::shared_ptr<const ReachImageBitmapOriginal> original,
+    int width,
+    int height,
+    ReachImageBitmapOriginal::Unpack restore) {
+  if (!HasTextureSource() || !original)
+    return;
+  auto* owner = new std::shared_ptr<const ReachImageBitmapOriginal>(original);
+  auto encoded = SkData::MakeWithProc(
+      original->bytes().data(), original->bytes().size(),
+      [](const void*, void* context) {
+        delete static_cast<std::shared_ptr<const ReachImageBitmapOriginal>*>(
+            context);
+      },
+      owner);
+  OriginalTexture(std::move(args), std::move(encoded), width, height);
+  if (!pending_->texture_source && pending_->error.empty()) {
+    pending_->unpack_before = original->unpack();
+    pending_->unpack_after = restore;
+    pending_->original_precharged = true;
+  }
+}
+
+bool ReachWebGLJournal::ReserveOriginalBytes(size_t size) {
+  if (!HasTextureSource() || size > kMaxOriginalBytes ||
+      !pending_->original_reservation.Reserve(RetainedBytes(), size + 256)) {
+    RejectTextureUpload("Combined WebGL pending original budget exceeded");
+    return false;
+  }
+  return true;
+}
+
+void ReachWebGLJournal::OriginalTexture(base::ListValue args,
+                                         sk_sp<const SkData> encoded,
+                                         int width,
+                                         int height) {
+  if (!HasTextureSource())
+    return;
+  if (!encoded || encoded->isEmpty() || !original_hasher ||
+      encoded->size() > kMaxOriginalBytes ||
+      width <= 0 || height <= 0 || width > 4096 || height > 4096) {
+    RejectTextureUpload("WebGL original encoded image unavailable or too large");
+    return;
+  }
+  const auto* op = pending_->value.FindString("op");
+  if (!op || pending_->error !=
+                 *op + ": WebGL source argument requires command transport")
+    return;
+  const auto* begin = static_cast<const uint8_t*>(encoded->data());
+  const auto hash =
+      original_hasher(UNSAFE_BUFFERS(base::span(begin, encoded->size())));
+  if (hash.size() != 64) {
+    RejectTextureUpload("WebGL original image digest unavailable");
+    return;
+  }
+  base::DictValue reference;
+  reference.Set("image", hash);
+  reference.Set("length", static_cast<int>(encoded->size()));
+  reference.Set("width", width);
+  reference.Set("height", height);
+  args.Append(std::move(reference));
+  pending_->value.Set("args", std::move(args));
+  pending_->original = std::move(encoded);
+  pending_->original_hash = hash;
+  pending_->error.clear();
+  pending_->texture_source = false;
+}
+
+void ReachWebGLJournal::TextureUpload(base::ListValue args,
+                                      unsigned type,
+                                      base::span<const uint8_t> pixels) {
+  if (!HasTextureSource())
+    return;
+  const std::string* op = pending_->value.FindString("op");
+  if (!op ||
+      (*op != "texImage2D" && *op != "texSubImage2D" && *op != "texImage3D" &&
+       *op != "texSubImage3D") ||
+      pending_->error !=
+          *op + ": WebGL source argument requires command transport") {
+    return;
+  }
+  std::string_view view;
+  switch (type) {
+    case GL_BYTE:
+      view = "Int8Array";
+      break;
+    case GL_UNSIGNED_BYTE:
+      view = "Uint8Array";
+      break;
+    case GL_SHORT:
+      view = "Int16Array";
+      break;
+    case GL_UNSIGNED_SHORT:
+    case GL_HALF_FLOAT:
+    case GL_HALF_FLOAT_OES:
+    case GL_UNSIGNED_SHORT_5_6_5:
+    case GL_UNSIGNED_SHORT_4_4_4_4:
+    case GL_UNSIGNED_SHORT_5_5_5_1:
+      view = "Uint16Array";
+      break;
+    case GL_INT:
+      view = "Int32Array";
+      break;
+    case GL_UNSIGNED_INT:
+    case GL_UNSIGNED_INT_2_10_10_10_REV:
+    case GL_UNSIGNED_INT_10F_11F_11F_REV:
+    case GL_UNSIGNED_INT_5_9_9_9_REV:
+      view = "Uint32Array";
+      break;
+    case GL_FLOAT:
+      view = "Float32Array";
+      break;
+    default:
+      RejectTextureUpload("Unsupported converted WebGL texture type");
+      return;
+  }
+  pending_->error.clear();
+  args.Append(Bytes(*pending_, view, pixels));
+  pending_->value.Set("args", std::move(args));
+  pending_->value.Set("unpack", true);
+}
+
+base::Value ReachWebGLJournal::Reference(ReachWebGLCommand& command,
+                                         const ScriptWrappable* object) {
+  auto it = identities_.find(object);
+  if (it == identities_.end() || it->second.object.Get() != object) {
+    command.error = "WebGL object was not recorded in this context";
+    return base::Value();
+  }
+  base::DictValue reference;
+  reference.Set("ref", static_cast<int>(it->second.id));
+  return base::Value(std::move(reference));
+}
+
+uint32_t ReachWebGLJournal::CreateIdentity(ReachWebGLCommand& command,
+                                           const ScriptWrappable* object) {
+  const auto previous = identities_.find(object);
+  if (identities_.size() >= kMaxObjects ||
+      (previous != identities_.end() && !previous->second.object))
+    Collect();
+  if (!usable() || !next_identity_ || identities_.size() >= kMaxObjects) {
+    command.error = "WebGL object identity budget exceeded";
+    return 0;
+  }
+  const uint32_t id = next_identity_++;
+  identities_.insert_or_assign(
+      object, Identity{WeakPersistent<const ScriptWrappable>(object), id});
+  return id;
+}
+
+void ReachWebGLJournal::Collect() {
+  base::ListValue args;
+  const auto append = [this, &args] {
+    ReachWebGLCommand command;
+    command.value.Set("op", "$collect");
+    command.value.Set("args", std::move(args));
+    args = base::ListValue();
+    Append(std::move(command));
+  };
+  for (auto it = identities_.begin(); it != identities_.end();) {
+    if (it->second.object) {
+      ++it;
+      continue;
+    }
+    base::DictValue reference;
+    reference.Set("ref", static_cast<int>(it->second.id));
+    args.Append(std::move(reference));
+    it = identities_.erase(it);
+    if (args.size() == 16) {
+      append();
+      if (!usable())
+        return;
+    }
+  }
+  if (!args.empty())
+    append();
+}
+
+void ReachWebGLJournal::Result(ReachWebGLCommand& command,
+                               const ScriptWrappable* object) {
+  if (object)
+    command.value.Set("out", static_cast<int>(CreateIdentity(command, object)));
+}
+
+void ReachWebGLJournal::Result(ReachWebGLCommand& command, uint32_t value) {
+  command.value.Set("value", static_cast<double>(value));
+}
+
+void ReachWebGLJournal::Target(ReachWebGLCommand& command,
+                               WebGLExtension* extension) {
+  auto value = Reference(command, extension);
+  if (value.is_dict()) {
+    const auto id = value.GetDict().FindInt("ref");
+    if (id)
+      command.value.Set("target", *id);
+  }
+}
+
+void ReachWebGLJournal::Extension(const String& name,
+                                  WebGLExtension* extension) {
+  if (!extension || !usable() || name == "WEBGL_lose_context" ||
+      name == "WEBGL_debug_shaders" || name == "WEBGL_debug_renderer_info")
+    return;
+  auto it = identities_.find(extension);
+  if (it != identities_.end() && it->second.object.Get() == extension)
+    return;
+  ReachWebGLCommand command;
+  command.value.Set("op", "getExtension");
+  base::ListValue args;
+  args.Append(name.Utf8());
+  command.value.Set("args", std::move(args));
+  Result(command, extension);
+  Append(std::move(command));
+}
+
+void ReachWebGLJournal::Program(ReachWebGLCommand& command,
+                                WebGLProgram* program) {
+  if (!program || !command.error.empty())
+    return;
+  auto* gl = context_->ContextGL();
+  GLint linked = 0;
+  gl->GetProgramiv(program->Object(), GL_LINK_STATUS, &linked);
+  command.value.Set("value", linked ? 1 : 0);
+  if (!linked)
+    return;
+  GLint count = 0;
+  GLint max_length = 0;
+  gl->GetProgramiv(program->Object(), GL_ACTIVE_ATTRIBUTES, &count);
+  gl->GetProgramiv(program->Object(), GL_ACTIVE_ATTRIBUTE_MAX_LENGTH,
+                   &max_length);
+  if (count < 0 || count > 32 || max_length < 0 || max_length > 1024) {
+    command.error = "WebGL program attribute budget exceeded";
+    return;
+  }
+  base::DictValue attributes;
+  const GLsizei name_capacity = std::max(1, max_length);
+  std::vector<char> name(name_capacity);
+  for (GLint index = 0; index < count; ++index) {
+    GLsizei length = 0;
+    GLint size = 0;
+    GLenum type = 0;
+    gl->GetActiveAttrib(program->Object(), index, name_capacity, &length, &size,
+                        &type, name.data());
+    if (length <= 0 || static_cast<size_t>(length) >= name.size()) {
+      command.error = "WebGL program attribute name is invalid";
+      return;
+    }
+    const GLint location =
+        gl->GetAttribLocation(program->Object(), name.data());
+    if (location < 0 || location > 31) {
+      command.error = "WebGL program attribute location is invalid";
+      return;
+    }
+    attributes.Set(std::string(name.data(), length), location);
+  }
+  command.value.Set("attributes", std::move(attributes));
+  if (!context_->IsWebGL2())
+    return;
+  // GLES2 requires initialized query destinations, including reused storage.
+  count = 0;
+  max_length = 0;
+  gl->GetProgramiv(program->Object(), GL_ACTIVE_UNIFORM_BLOCKS, &count);
+  gl->GetProgramiv(program->Object(), GL_ACTIVE_UNIFORM_BLOCK_MAX_NAME_LENGTH,
+                   &max_length);
+  if (count < 0 || count > 256 || max_length < 0 || max_length > 1024) {
+    command.error = "WebGL program uniform block budget exceeded";
+    return;
+  }
+  base::DictValue blocks;
+  const GLsizei block_name_capacity = std::max(1, max_length);
+  name.resize(block_name_capacity);
+  for (GLint index = 0; index < count; ++index) {
+    GLsizei length = 0;
+    gl->GetActiveUniformBlockName(program->Object(), index, block_name_capacity,
+                                  &length, name.data());
+    if (length <= 0 || static_cast<size_t>(length) >= name.size()) {
+      command.error = "WebGL program uniform block name is invalid";
+      return;
+    }
+    blocks.Set(std::string(name.data(), length), index);
+  }
+  command.value.Set("uniformBlocks", std::move(blocks));
+}
+
+void ReachWebGLJournal::Append(ReachWebGLCommand command) {
+  if (!usable())
+    return;
+  if (!command.error.empty()) {
+    Fail(command.error);
+    return;
+  }
+  if (command.unpack_before) {
+    constexpr std::array<int, 3> names{37440, 37441, 37443};
+    for (size_t i = 0; i < names.size(); ++i) {
+      ReachWebGLCommand unpack;
+      unpack.value.Set("op", "pixelStorei");
+      base::ListValue args;
+      args.Append(names[i]);
+      args.Append((*command.unpack_before)[i]);
+      unpack.value.Set("args", std::move(args));
+      Append(std::move(unpack));
+      if (!usable())
+        return;
+    }
+  }
+  const size_t captured_bytes = command.value.EstimateMemoryUsage();
+  const size_t serialized_bound = std::max(command.input_bytes, captured_bytes);
+  if (captured_bytes > kMaxCommandBytes - 512 ||
+      !command.reservation.Reserve(RetainedBytes(), captured_bytes + 512)) {
+    Fail("Combined WebGL pending command budget exceeded");
+    return;
+  }
+  // The value tree remains owned while JSONWriter fills a distinct buffer.
+  ReachWebGLPending::Reservation serialized;
+  if (serialized_bound > kMaxCommandBytes - 512 ||
+      !serialized.Reserve(RetainedBytes(), serialized_bound + 512)) {
+    Fail("Combined WebGL pending serialization budget exceeded");
+    return;
+  }
+  std::optional<std::string> json(std::in_place);
+  json->reserve(serialized_bound + 512);
+  if (json->capacity() > kMaxCommandBytes - 512 ||
+      !serialized.Reserve(RetainedBytes(), json->capacity() + 512)) {
+    Fail("Combined WebGL pending serialization budget exceeded");
+    return;
+  }
+  if (!base::JSONWriter::Write(command.value, &*json))
+    json.reset();
+  if (!json || json->size() > kMaxCommandBytes) {
+    Fail("WebGL command delivery size exceeded");
+    return;
+  }
+  command.value = base::DictValue();
+  command.reservation = ReachWebGLPending::Reservation();
+  if (command.original && !originals_.contains(command.original_hash)) {
+    const size_t charge =
+        (command.original_precharged ? 0 : command.original->size()) + 256;
+    if (!command.original_reservation.Reserve(RetainedBytes(), charge)) {
+      Fail("Combined WebGL pending original budget exceeded");
+      return;
+    }
+    originals_.emplace(
+        command.original_hash,
+        Original{command.original, commands_.next() + 1, charge});
+    command.original_reservation.Transfer();
+    original_bytes_ += charge;
+  }
+  const std::string error = commands_.Append(
+      std::move(*json), command.original ? command.original->size() : 0,
+      command.original_hash, &serialized);
+  if (error.empty() && command.original)
+    originals_.at(command.original_hash).last_next = commands_.next();
+  if (!error.empty())
+    Fail(error);
+  else
+    NotifyChange();
+  if (command.unpack_after && usable()) {
+    constexpr std::array<int, 3> names{37440, 37441, 37443};
+    for (size_t i = 0; i < names.size(); ++i) {
+      ReachWebGLCommand unpack;
+      unpack.value.Set("op", "pixelStorei");
+      base::ListValue args;
+      args.Append(names[i]);
+      args.Append((*command.unpack_after)[i]);
+      unpack.value.Set("args", std::move(args));
+      Append(std::move(unpack));
+      if (!usable())
+        return;
+    }
+  }
+}
+
+void ReachWebGLJournal::Resize(int width, int height) {
+  if (width <= 0 || width > 4096 || height <= 0 || height > 4096) {
+    Fail("WebGL backing size exceeds the command budget");
+    return;
+  }
+  ReachWebGLCommand command;
+  command.value.Set("op", "$resize");
+  base::ListValue args;
+  args.Append(width);
+  args.Append(height);
+  command.value.Set("args", std::move(args));
+  Append(std::move(command));
+}
+
+void ReachWebGLJournal::Discard() {
+  ReachWebGLCommand command;
+  command.value.Set("op", "$discard");
+  command.value.Set("args", base::ListValue());
+  Append(std::move(command));
+}
+
+std::string ReachWebGLJournal::State() {
+  if (!usable() || !element_ || !context_ || context_->isContextLost())
+    return {};
+  Collect();
+  if (!usable())
+    return {};
+  auto* attributes = context_->getContextAttributes();
+  if (!attributes)
+    return {};
+  base::DictValue state;
+  state.Set("webgl", 2);
+  state.Set("id", element_->GetDomNodeId());
+  state.Set("stream", base::NumberToString(id_));
+  state.Set("generation", base::NumberToString(generation_));
+  state.Set("seq", base::NumberToString(commands_.next()));
+  state.Set("version", context_->IsWebGL2() ? 2 : 1);
+  state.Set("width", context_->drawingBufferWidth());
+  state.Set("height", context_->drawingBufferHeight());
+  base::DictValue settings;
+  settings.Set("alpha", attributes->alpha());
+  settings.Set("depth", attributes->depth());
+  settings.Set("stencil", attributes->stencil());
+  settings.Set("antialias", attributes->antialias());
+  settings.Set("premultipliedAlpha", attributes->premultipliedAlpha());
+  settings.Set("preserveDrawingBuffer", attributes->preserveDrawingBuffer());
+  state.Set("attributes", std::move(settings));
+  auto json = base::WriteJson(state);
+  if (!json) {
+    Fail("WebGL metadata serialization failed");
+    return {};
+  }
+  return std::move(*json);
+}
+
+std::string ReachWebGLJournal::Read(uint64_t cursor,
+                                    size_t max_bytes,
+                                    std::vector<uint8_t>* output,
+                                    std::map<std::string,
+                                             std::vector<uint8_t>>* originals) {
+  if (!usable() || max_bytes <= 256)
+    return "WebGL command delivery unavailable or cursor invalid";
+  uint64_t end = cursor;
+  std::string commands;
+  std::string error =
+      commands_.Read(generation_, cursor, max_bytes - 256, &commands, &end);
+  if (!error.empty())
+    return error;
+  std::string json = "{\"version\":2,\"stream\":\"" + base::NumberToString(id_) +
+                     "\",\"generation\":\"" + base::NumberToString(generation_) +
+                     "\",\"from\":\"" + base::NumberToString(cursor) +
+                     "\",\"next\":\"" + base::NumberToString(end) +
+                     "\",\"commands\":" + commands + "}";
+  if (json.size() > max_bytes)
+    return "WebGL command response exceeds its byte budget";
+  for (const auto& [hash, original] : originals_) {
+    if (commands.find("\"image\":\"" + hash + "\"") == std::string::npos)
+      continue;
+    const auto* begin = static_cast<const uint8_t*>(original.data->data());
+    originals->emplace("image:" + hash,
+        UNSAFE_BUFFERS(std::vector<uint8_t>(
+            begin, begin + original.data->size())));
+  }
+  output->assign(json.begin(), json.end());
+  return {};
+}
+
+std::string ReachWebGLJournal::ReadSlice(
+    uint64_t cursor,
+    size_t offset,
+    size_t max_bytes,
+    bool original,
+    std::vector<uint8_t>* output,
+    std::map<std::string, std::vector<uint8_t>>* data) {
+  if (!usable())
+    return "WebGL slice stream is unavailable";
+  ReachWebGLPending::Slice slice;
+  std::string command;
+  auto error = commands_.ReadSlice(generation_, cursor, offset, max_bytes,
+                                   original, &command, &slice);
+  if (!error.empty())
+    return error;
+  base::DictValue header;
+  header.Set("stream", base::NumberToString(id_));
+  header.Set("generation", base::NumberToString(generation_));
+  header.Set("command", base::NumberToString(cursor));
+  header.Set("offset", static_cast<int>(offset));
+  header.Set("total", static_cast<int>(slice.total));
+  header.Set("original", original);
+  header.Set("image", slice.original_hash);
+  header.Set("length", static_cast<int>(slice.original_bytes));
+  auto json = base::WriteJson(header);
+  if (!json)
+    return "WebGL slice header serialization failed";
+  output->assign(json->begin(), json->end());
+  if (original) {
+    const auto it = originals_.find(slice.original_hash);
+    if (it == originals_.end() || it->second.data->size() != slice.total)
+      return "WebGL slice original is unavailable";
+    const auto* begin = static_cast<const uint8_t*>(it->second.data->data());
+    data->emplace("chunk", UNSAFE_BUFFERS(std::vector<uint8_t>(
+                               begin + offset, begin + offset + slice.length)));
+  } else {
+    data->emplace("chunk",
+                  std::vector<uint8_t>(command.begin(), command.end()));
+  }
+  return {};
+}
+
+std::string ReachWebGLJournal::Applied(uint64_t generation, uint64_t through) {
+  if (!usable() || generation != generation_)
+    return "WebGL applied generation is stale or unavailable";
+  const auto error = commands_.Applied(generation, through);
+  if (!error.empty())
+    return error;
+  for (auto it = originals_.begin(); it != originals_.end();) {
+    if (it->second.last_next <= through) {
+      const size_t charge = it->second.charge;
+      original_bytes_ -= charge;
+      RetainedBytes().fetch_sub(charge);
+      it = originals_.erase(it);
+    } else {
+      ++it;
+    }
+  }
+  return {};
+}
+
+}  // namespace blink
