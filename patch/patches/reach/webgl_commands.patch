+  // Only immutable pending storage is sliced. No response snapshot or delivered
+  // command archive survives a request. Original bytes remain journal-owned.
+  std::string ReadSlice(uint64_t generation,
+                        uint64_t cursor,
+                        size_t offset,
+                        size_t max_bytes,
+                        bool original,
+                        std::string* data,
+                        Slice* slice) {
+    if (generation != generation_ || cursor < retired_ ||
+        cursor > read_through_ || max_bytes == 0 || max_bytes > kMaxSlice)
+      return "WebGL slice generation, cursor, or budget is invalid";
+    *slice = {};
+    data->clear();
+    if (cursor == next_)
