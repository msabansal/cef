+    if (cursor < retired_ || cursor > read_through_ || max_bytes <= 2)
+      return "WebGL cursor is retired, future, or skips an unread prefix";
+    auto it = commands_.begin();
+    std::advance(it, cursor - retired_);
+    *commands = "[";
+    *end = cursor;
+    size_t delivery = 0;
+    for (; it != commands_.end(); ++it) {
+      const size_t separator = *end == cursor ? 0 : 1;
+      if (it->value.size() + separator + 1 + it->delivery_bytes >
+          max_bytes - commands->size() - delivery)
+        break;
+      if (separator)
+        *commands += ',';
+      *commands += it->value;
+      delivery += it->delivery_bytes;
+      ++*end;
