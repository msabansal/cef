diff --git src/core/SkReachResource.h src/core/SkReachResource.h
new file mode 100644
index 00000000..3084c1ee
--- /dev/null
+++ src/core/SkReachResource.h
@@ -0,0 +1,90 @@
+#ifndef SkReachResource_DEFINED
+#define SkReachResource_DEFINED
+
+#include "include/core/SkData.h"
+#include "include/core/SkStream.h"
+#include "src/core/SkFontDescriptor.h"
+#include <array>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace sk_reach {
+constexpr size_t kImageBytes = 4 * 1024 * 1024;
+constexpr size_t kFontBytes = 32 * 1024 * 1024;
+constexpr size_t kDescriptorBytes = 4096;
+constexpr size_t kHeaderBytes = 48;
+constexpr uint8_t kImage = 1;
+constexpr uint8_t kFont = 2;
+using Hash = std::array<uint8_t, 32>;
+
+inline uint32_t Read32(const uint8_t* p) {
+    return uint32_t(p[0]) | uint32_t(p[1]) << 8 |
+           uint32_t(p[2]) << 16 | uint32_t(p[3]) << 24;
+}
+inline void Write32(uint8_t* p, uint32_t value) {
+    for (size_t i = 0; i < 4; ++i) p[i] = uint8_t(value >> (8 * i));
+}
+inline std::string Hex(const Hash& hash) {
+    static constexpr char digits[] = "0123456789abcdef";
+    std::string text;
+    text.reserve(64);
+    for (uint8_t byte : hash) {
+        text.push_back(digits[byte >> 4]);
+        text.push_back(digits[byte & 15]);
+    }
+    return text;
+}
+struct Reference {
+    uint8_t kind = 0;
+    uint32_t length = 0;
+    Hash hash{};
+    sk_sp<SkData> descriptor;
+};
+inline bool Read(SkStream& stream, uint8_t kind, Reference* ref) {
+    uint8_t header[kHeaderBytes];
+    if (stream.read(header, sizeof(header)) != sizeof(header) ||
+        std::memcmp(header, "REACHRS2", 8) || header[8] != kind ||
+        header[9] || header[10] || header[11]) return false;
+    ref->kind = kind;
+    ref->length = Read32(header + 12);
+    if (!ref->length ||
+        ref->length > (kind == kImage ? kImageBytes : kFontBytes)) return false;
+    std::memcpy(ref->hash.data(), header + 16, ref->hash.size());
+    if (kind == kFont) {
+        uint8_t size[4];
+        if (stream.read(size, 4) != 4) return false;
+        const uint32_t length = Read32(size);
+        if (!length || length > kDescriptorBytes) return false;
+        ref->descriptor = SkData::MakeUninitialized(length);
+        if (stream.read(ref->descriptor->writable_data(), length) != length) return false;
+    }
+    return true;
+}
+inline sk_sp<SkData> Write(uint8_t kind, const Hash& hash, size_t length,
+                           const SkData* descriptor = nullptr) {
+    if (!length || length > (kind == kImage ? kImageBytes : kFontBytes) ||
+        (kind == kFont && (!descriptor || !descriptor->size() ||
+                         descriptor->size() > kDescriptorBytes))) return nullptr;
+    const size_t extra = kind == kFont ? 4 + descriptor->size() : 0;
+    auto data = SkData::MakeUninitialized(kHeaderBytes + extra);
+    auto* out = static_cast<uint8_t*>(data->writable_data());
+    std::memset(out, 0, kHeaderBytes);
+    std::memcpy(out, "REACHRS2", 8);
+    out[8] = kind;
+    Write32(out + 12, length);
+    std::memcpy(out + 16, hash.data(), hash.size());
+    if (kind == kFont) {
+        Write32(out + kHeaderBytes, descriptor->size());
+        std::memcpy(out + kHeaderBytes + 4, descriptor->data(), descriptor->size());
+    }
+    return data;
+}
+inline bool Descriptor(const Reference& ref, SkFontDescriptor* descriptor) {
+    if (!ref.descriptor) return false;
+    SkMemoryStream stream(ref.descriptor);
+    return SkFontDescriptor::Deserialize(&stream, descriptor) &&
+           !descriptor->hasStream() && stream.getPosition() == ref.descriptor->size();
+}
+}  // namespace sk_reach
+#endif
